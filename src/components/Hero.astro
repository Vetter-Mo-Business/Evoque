---
import heroLogo from '../assets/logos/hero.png';
import heroPoster from '../assets/hero/poster.jpg';
// Intro (spielt einmal) + Loop (endlos), je als WebM (klein) + MP4 (Fallback)
import introWebm from '../assets/hero/intro.webm?url';
import introMp4 from '../assets/hero/intro.mp4?url';
import loopWebm from '../assets/hero/loop.webm?url';
import loopMp4 from '../assets/hero/loop.mp4?url';

interface Props {
  poster?: string;
  ctaHref?: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  poster,
  ctaHref,
  ctaLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="hero">
  <div class="hero__stage">
    <!-- Zwei Media-Ebenen: Intro (Teil1-2) spielt einmal, danach übernimmt das
         Loop-Video (Teil2) darunter; das Intro blendet oben aus (kein Abdunkeln). -->
    <video
      class="hero__media hero__loop"
      loop
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source src={loopWebm} type="video/webm" />
      <source src={loopMp4} type="video/mp4" />
    </video>
    <video
      class="hero__media hero__video"
      poster={poster ?? heroPoster.src}
      muted
      playsinline
      preload="auto"
      data-fade="1"
    >
      <source src={introWebm} type="video/webm" />
      <source src={introMp4} type="video/mp4" />
    </video>

    <div class="hero__overlay">
      <div class="hero__content">
        <img
          class="hero__logo"
          src={heroLogo.src}
          alt="EVOQUE yourself"
          decoding="async"
        />
        {
          (ctaHref && ctaLabel) || (secondaryHref && secondaryLabel) ? (
            <div class="hero__actions">
              {secondaryHref && secondaryLabel && (
                <a href={secondaryHref} class="btn btn--secondary hero__btn">
                  {secondaryLabel}
                </a>
              )}
              {ctaHref && ctaLabel && (
                <a href={ctaHref} class="btn btn--primary hero__btn">
                  {ctaLabel}
                </a>
              )}
            </div>
          ) : null
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* ===== Stellschrauben (cqw = 1% der Videobreite, skaliert mit dem Video) ===== */
    --hero-max-width: 100%;                         /* max. Videobreite */
    --hero-height: calc(100svh - 76px);             /* Höhe: 1. Bildschirm minus Navbar */
    --hero-logo-size: clamp(8rem, 26cqw, 28rem);    /* Logo-Grundgröße */
    --hero-logo-scale: 1;                           /* Logo-Faktor (1.2 = 20% größer) */
    --hero-logo-x: 0cqw;                            /* Logo horizontal (− links / + rechts) */
    --hero-logo-y: 2.5cqw;                          /* Logo vertikal (− oben / + unten) */
    --hero-content-width: 60cqw;                    /* Textblock-Breite (greift beim Umbruch) */
    --hero-actions-gap: 5cqw;                        /* Abstand Logo ↔ Buttons */
    --hero-buttons-y: -1cqw;                         /* Buttons vertikal (− oben / + unten) */
    --hero-btn-size: clamp(0.55rem, 1.9cqw, 1.1rem); /* Button-Schriftgröße */
    --hero-text-x: 0px;                              /* Inhalt horizontal */
    --hero-text-y: 3cqw;                             /* Inhalt vertikal */

    overflow: hidden;
  }

  /* Bühne: zentriert, begrenzt, 16:9 */
  .hero__stage {
    position: relative;
    width: 100%;
    max-width: var(--hero-max-width);
    margin-inline: auto;
    height: var(--hero-height);
    overflow: hidden;
    background: var(--forest-deep, #0f1f17);
    container-type: inline-size; /* cqw relativ zur Videobreite */
  }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    will-change: opacity; /* Opacity-Überblendung per JS */
  }

  /* Startzustand: Intro oben sichtbar, Loop darunter */
  .hero__loop {
    z-index: 0;
    opacity: 0;
  }
  .hero__video {
    z-index: 1;
    opacity: 1;
  }

  /* Inhalts-Ebene über dem Video */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(var(--hero-text-x), var(--hero-text-y));
    pointer-events: none;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--hero-actions-gap);
    text-align: center;
  }

  .hero__logo {
    display: block;
    width: calc(var(--hero-logo-size) * var(--hero-logo-scale));
    height: auto;
    /* aspect-ratio reserviert den Platz vor dem Laden (sonst springt der Inhalt) */
    aspect-ratio: 4283 / 4077;
    transform: translate(var(--hero-logo-x), var(--hero-logo-y));
    filter: drop-shadow(0 0.3cqw 2cqw rgba(255, 255, 255, 0.55));
  }

  .hero__actions {
    /* Buttons liegen über dem Logo und lassen sich per --hero-buttons-y verschieben */
    position: relative;
    z-index: 2;
    transform: translateY(var(--hero-buttons-y));
    display: flex;
    flex-wrap: wrap;
    gap: 2cqw;
    justify-content: center;
  }

  /* Schmales Video: Inhalt bricht um, Buttons untereinander */
  @container (max-width: 680px) {
    .hero__content {
      max-width: var(--hero-content-width);
    }
    .hero__actions {
      flex-direction: column;
      align-items: center;
    }
    .hero__btn {
      width: auto;
    }
  }

  /* Blumenkranz immer ganz zeigen: schmaler als 16:9 -> Höhe aus der Breite
     ableiten, statt die Seiten per object-fit: cover abzuschneiden */
  @media (max-aspect-ratio: 16 / 9) {
    .hero__stage {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  /* Buttons skalieren mit dem Video */
  .hero__btn {
    pointer-events: auto;
    font-size: var(--hero-btn-size);
    padding: 0.9em 1.8em;
  }

  /* Handy: Buttons kompakter */
  @media (max-width: 640px) {
    .hero {
      --hero-btn-size: clamp(0.46rem, 1.9cqw, 0.8rem);
    }
    .hero__btn {
      padding: 0.7em 1.35em;
      border-width: 1px;
    }
  }
</style>

<script>
  // Intro spielt einmal, danach Wechsel auf das Loop-Video (ohne Abdunkeln)
  document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const video = hero.querySelector<HTMLVideoElement>('.hero__video');
    const loop = hero.querySelector<HTMLVideoElement>('.hero__loop');
    if (!video || !loop) return;

    for (const v of [video, loop]) {
      v.muted = true;
      v.defaultMuted = true;
      v.setAttribute('muted', '');
    }
    video.loop = false;
    loop.loop = true;

    // Loop erst laden, sobald das Intro genug Daten hat (spart Anfangs-Bandbreite)
    const preloadLoop = () => {
      if (loop.preload === 'auto') return;
      loop.preload = 'auto';
      loop.load();
    };
    video.addEventListener('canplay', preloadLoop, { once: true });

    const safePlay = () => {
      const p = video.play();
      if (p) p.catch(() => {});
    };

    let switched = false;
    const showLoop = () => {
      if (switched) return;
      switched = true;

      // Direkter Wechsel, aber erst wenn der Loop ein Bild liefert (keine Lücke)
      const reveal = () => {
        loop.style.transition = 'none';
        video.style.transition = 'none';
        loop.style.opacity = '1';
        video.style.opacity = '0';
      };

      preloadLoop();
      loop.currentTime = 0;
      const p = loop.play();
      if (p) p.catch(reveal); // Blockiert der Browser den Start: trotzdem zeigen

      // Auf den ersten gerenderten Frame warten (Fallback ohne requestVideoFrameCallback)
      if (typeof loop.requestVideoFrameCallback === 'function') {
        loop.requestVideoFrameCallback(() => reveal());
      } else {
        loop.addEventListener('playing', reveal, { once: true });
      }
      setTimeout(reveal, 1000); // letzte Sicherung

    };

    video.addEventListener('ended', showLoop);

    // Autoplay anstoßen
    safePlay();
    video.addEventListener('loadeddata', safePlay, { once: true });
    video.addEventListener('canplay', safePlay, { once: true });

    // Fallback: bei blockiertem Autoplay bei erster Interaktion starten
    const onInteract = () => {
      if (!switched) safePlay();
      window.removeEventListener('pointerdown', onInteract);
      window.removeEventListener('touchstart', onInteract);
      window.removeEventListener('scroll', onInteract);
    };
    window.addEventListener('pointerdown', onInteract, { passive: true });
    window.addEventListener('touchstart', onInteract, { passive: true });
    window.addEventListener('scroll', onInteract, { passive: true });
  });
</script>
