---
import heroLogo from '../assets/about/Hero_Logo.svg';
import heroVideo from '../assets/about/Teil1-2.mp4?url';
import heroGif from '../assets/about/Teil2.gif?url';

interface Props {
  poster?: string;
  subtitle?: string;
  ctaHref?: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  poster,
  subtitle = 'become your best you',
  ctaHref,
  ctaLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="hero">
  <div class="hero__stage">
    <!-- Zwei Media-Ebenen: Das Video (Teil1-2) spielt EINMAL die Intro-
         Animation. Wenn es fertig ist, wird sanft (ohne harten Schnitt) auf
         das GIF (Teil2) übergeblendet, das die ruhige Blätter-Bewegung von
         sich aus endlos loopt. Das GIF liegt voll deckend UNTEN, das Video
         blendet OBEN aus -> es wird nie dunkler. -->
    <img
      class="hero__media hero__gif"
      data-src={heroGif}
      alt=""
      aria-hidden="true"
      decoding="async"
    />
    <video
      class="hero__media hero__video"
      src={heroVideo}
      poster={poster}
      muted
      playsinline
      preload="auto"
      data-fade="1"
    ></video>

    <div class="hero__overlay">
      <div class="hero__content">
        <div class="hero__headline">
          <img
            class="hero__logo"
            src={heroLogo.src}
            alt="EVOQUE yourself"
            decoding="async"
          />
          {subtitle && <p class="hero__subtitle">{subtitle}</p>}
        </div>
        {
          (ctaHref && ctaLabel) || (secondaryHref && secondaryLabel) ? (
            <div class="hero__actions">
              {secondaryHref && secondaryLabel && (
                <a href={secondaryHref} class="btn btn--secondary hero__btn">
                  {secondaryLabel}
                </a>
              )}
              {ctaHref && ctaLabel && (
                <a href={ctaHref} class="btn btn--primary hero__btn">
                  {ctaLabel}
                </a>
              )}
            </div>
          ) : null
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* =================================================================
       HIER ANPASSEN
       Alle Werte skalieren mit der Videobreite (cqw = 1% der Videobreite).
       Dadurch bleibt der Inhalt auf JEDEM Bildschirm gleich groß im
       Verhältnis zum Blumenkranz – also immer mittig innerhalb davon.
       ================================================================= */

    /* Maximale Breite des Videos.
       100% = volle Bildschirmbreite. Für kleiner z.B. 1040px setzen. */
    --hero-max-width: 100%;

    /* Höhe der Hero-Sektion. Das Video wird oben/unten passend
       beschnitten (object-fit: cover), um genau diese Höhe zu füllen,
       ohne das Seitenverhältnis zu verzerren.
       Standard: erster Bildschirm abzüglich Navbar-Höhe (76px). */
    --hero-height: calc(100svh - 76px);

    /* Breite des Logos "EVOQUE yourself" (oben).
       clamp(min, fließend, max): mittlerer Wert in cqw steuert die Größe.
       Der min-Wert ist klein, damit das Logo beim Verkleinern des
       Bildschirms wirklich weiter mitschrumpft. */
    --hero-logo-width: clamp(8rem, 50cqw, 50rem);

    /* Schriftgröße der Unterzeile "become your best you" (kleiner). */
    --hero-subtitle-size: clamp(0.5rem, 2.4cqw, 1.5rem);

    /* Textfarbe der Unterzeile (Dunkelgrün) */
    --hero-text-color: var(--forest-deep);

    /* Breite des Textblocks – hält den Inhalt innerhalb des Blumenkranzes.
       Greift, sobald der Text umbricht (kleine Bildschirme). */
    --hero-content-width: 60cqw;

    /* Abstand zwischen Überschrift-Block und Buttons (Buttons höher/tiefer) */
    --hero-actions-gap: 5cqw;

    /* Abstand zwischen Logo und der Unterzeile (negativ erlaubt).
       Das Logo-SVG ist bereits eng um den Text beschnitten. Mit diesem Wert
       kann die Unterzeile (und mit ihr die Buttons) fein justiert werden:
       negativ = näher/höher an "yourself", positiv = tiefer. */
    --hero-headline-gap: 0.5cqw;

    /* Größe der Buttons (Schrift) – skaliert ebenfalls mit dem Video.
       Kleiner min-Wert, damit die Buttons mitschrumpfen. */
    --hero-btn-size: clamp(0.55rem, 1.9cqw, 1.1rem);

    /* Horizontale Verschiebung von Inhalt (− links / + rechts) */
    --hero-text-x: 0px;

    /* Vertikale Verschiebung von Inhalt (− nach oben / + nach unten).
       In cqw, damit sie proportional zum Video bleibt. Hier nachjustieren,
       um alles minimal höher/tiefer zu rücken. */
    --hero-text-y: 3cqw;

    /* =================================================================
       Ab hier in der Regel nichts mehr ändern
       ================================================================= */

    overflow: hidden;
  }

  /* Bühne hält das 16:9-Verhältnis, ist zentriert und begrenzt */
  .hero__stage {
    position: relative;
    width: 100%;
    max-width: var(--hero-max-width);
    margin-inline: auto;
    height: var(--hero-height);
    overflow: hidden;
    background: var(--forest-deep, #0f1f17);
    /* macht cqw-Einheiten relativ zur Videobreite verfügbar */
    container-type: inline-size;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Opacity wird per JS für die Überblendung gesteuert. */
    will-change: opacity;
  }

  /* Startzustand: Video oben sichtbar, GIF darunter (wird beim Ende
     eingeblendet, während das Video ausblendet). */
  .hero__gif {
    z-index: 0;
    opacity: 0;
  }
  .hero__video {
    z-index: 1;
    opacity: 1;
  }

  /* Zentrierte Inhalts-Ebene über dem Video */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(var(--hero-text-x), var(--hero-text-y));
    pointer-events: none;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--hero-actions-gap);
    text-align: center;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__logo {
    display: block;
    width: var(--hero-logo-width);
    height: auto;
    /* sanfter heller Schein für Lesbarkeit auf dem Video */
    filter: drop-shadow(0 0.3cqw 2cqw rgba(255, 255, 255, 0.55));
  }

  .hero__subtitle {
    /* margin-top statt flex-gap: darf negativ sein, damit die Unterzeile
       dicht unter "yourself" gezogen werden kann. */
    margin: var(--hero-headline-gap) 0 0;
    color: var(--hero-text-color);
    font-size: var(--hero-subtitle-size);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
    white-space: nowrap;
    text-shadow: 0 0.3cqw 2cqw rgba(255, 255, 255, 0.55);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 2cqw;
    justify-content: center;
  }

  /* Wird das Video (= der Kranz) schmal, bricht der Inhalt um und die
     Buttons stehen untereinander – alles bleibt mittig. */
  @container (max-width: 680px) {
    .hero__content {
      /* erst beim Umbruch begrenzen, damit der Inhalt im Kranz bleibt */
      max-width: var(--hero-content-width);
    }
    .hero__subtitle {
      white-space: normal;
    }
    .hero__actions {
      flex-direction: column;
      align-items: center;
    }
    .hero__btn {
      /* nur so breit wie das Wort darin – schrumpft mit */
      width: auto;
    }
  }

  /* Auf schmalen Bildschirmen das volle 16:9 zeigen, statt seitlich
     stark zu beschneiden – so bleibt der ganze Blumenkranz sichtbar. */
  @media (max-width: 680px) {
    .hero__stage {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  /* Buttons skalieren mit dem Video */
  .hero__btn {
    pointer-events: auto;
    font-size: var(--hero-btn-size);
    padding: 0.9em 1.8em;
  }
</style>

<script>
  // Ablauf: Das Video (Teil1-2) spielt EINMAL die Intro-Animation. Sobald es
  // zu Ende ist, wird sanft (ohne harten Schnitt) auf das GIF (Teil2)
  // übergeblendet, das die ruhige Blätter-Bewegung von sich aus endlos loopt.
  //
  // Kein Abdunkeln: Das GIF liegt voll deckend UNTEN und wird zuerst sichtbar
  // gemacht, danach blendet nur das Video OBEN aus. Das Bild ist dadurch immer
  // vollständig gedeckt.
  document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const video = hero.querySelector<HTMLVideoElement>('.hero__video');
    const gif = hero.querySelector<HTMLImageElement>('.hero__gif');
    if (!video || !gif) return;

    const gifUrl = gif.dataset.src || '';

    video.muted = true;
    video.defaultMuted = true;
    video.setAttribute('muted', '');
    video.loop = false;

    // GIF vorab in den Cache laden, damit der Wechsel verzögerungsfrei ist.
    if (gifUrl) new Image().src = gifUrl;

    const safePlay = () => {
      const p = video.play();
      if (p) p.catch(() => {});
    };

    let switched = false;
    const showGif = () => {
      if (switched) return;
      switched = true;

      // GIF frisch laden -> startet garantiert bei Frame 0 (= letzter
      // Video-Frame). DIREKTER Wechsel ohne Überblendung, aber erst wenn das
      // GIF fertig dekodiert ist. Bis dahin bleibt das Video auf seinem
      // eingefrorenen letzten Frame stehen -> keine Lücke, kein Abdunkeln.
      gif.src = gifUrl;

      const reveal = () => {
        gif.style.transition = 'none';
        video.style.transition = 'none';
        gif.style.opacity = '1';
        video.style.opacity = '0';
      };

      if (typeof gif.decode === 'function') {
        gif.decode().then(reveal).catch(reveal);
      } else if (gif.complete) {
        reveal();
      } else {
        gif.addEventListener('load', reveal, { once: true });
      }
    };

    video.addEventListener('ended', showGif);

    // Autoplay zuverlässig anstoßen (frisch deployte Domain ist strenger).
    safePlay();
    video.addEventListener('loadeddata', safePlay, { once: true });
    video.addEventListener('canplay', safePlay, { once: true });

    // Letzter Fallback: sollte der Browser den Start blockieren, startet das
    // Video bei der ersten Interaktion des Besuchers.
    const onInteract = () => {
      if (!switched) safePlay();
      window.removeEventListener('pointerdown', onInteract);
      window.removeEventListener('touchstart', onInteract);
      window.removeEventListener('scroll', onInteract);
    };
    window.addEventListener('pointerdown', onInteract, { passive: true });
    window.addEventListener('touchstart', onInteract, { passive: true });
    window.addEventListener('scroll', onInteract, { passive: true });
  });
</script>
