---
interface Step {
  num: string;
  title: string;
  text: string;
  /** Vertikale Lage = Knoten-cy / viewBox-Höhe (760). node-1 unten … node-4 oben. */
  top: string;
}

// DOM-Reihenfolge = logische Lesereihenfolge 01 → 06.
// top = cy/760: node-1 cy=725 → 95.395% (unten) … node-6 cy=120 → 15.789% (oben).
// Knoten über fast die gesamte Stielhöhe verteilt: oberster Punkt nah an
// der Überschrift, unterster knapp über dem Boden – maximaler Box-Abstand.
const steps: Step[] = [
  {
    num: '01',
    title: 'Kennenlerngespräch',
    text: 'Wir schauen, wo dein Problem auftritt. Zunächst klären wir wie, wann und warum das Verhalten besteht.',
    top: '95.395%',
  },
  {
    num: '02',
    title: 'Ursachenforschung',
    text: 'Wir schauen uns an, wo das Verhalten entstanden sein könnte. Verständnis ist die zentrale Basis für Veränderung.',
    top: '79.474%',
  },
  {
    num: '03',
    title: 'Ziele festlegen',
    text: 'Wir bestimmen Dein Ziel und den Weg dorthin.',
    top: '63.553%',
  },
  {
    num: '04',
    title: 'Praxisnahe Anwendung',
    text: 'Wir wenden erste praktische Übungen an, um Deine alten Muster Schritt für Schritt in positive Verhaltenskonsequenzen umzuwandeln.',
    top: '47.632%',
  },
  {
    num: '05',
    title: 'Reflexion',
    text: 'Veränderung ist ein stetiger Prozess. Wir reflektieren gemeinsam und schärfen an den Stellen nach, wo es noch nicht funktioniert.',
    top: '31.711%',
  },
  {
    num: '06',
    title: 'Nachhaltige Zielerreichung',
    text: 'Idealerweise hast Du am Ende unseres Coachings bereits Dein Ziel erreicht. Wenn nicht, hast Du auf dem Weg alle Werkzeuge mitnehmen können, dich nun selbständig auszuprobieren.',
    top: '15.789%',
  },
];
---

<section class="journey" id="ablauf" data-journey>
  <div class="journey__pin" data-pin>
    <!-- Kopf: zentriert oben, bleibt während des Pins sichtbar -->
    <div class="container journey__head">
      <p class="eyebrow">Der Ablauf</p>
      <h2>Dein Weg zum Ziel</h2>
    </div>

    <div class="container journey__cols">
      <!-- Links: Pflanzen-SVG (inline, damit Stem/Blätter/Knoten animierbar sind) -->
      <div class="journey__plant" data-plant>
        <svg
          class="plant"
          viewBox="0 0 240 760"
          fill="none"
          aria-hidden="true"
        >
          <g
            class="plant__ink"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Wurzeln / Der Anfang: die Pflanze bricht unten aus der Erde.
                 Statisch sichtbar – der Startpunkt des Weges. -->
            <g class="roots">
              <!-- weit links außen -->
              <path class="root" d="M120,748 C102,756 80,764 60,782"></path>
              <!-- links -->
              <path class="root" d="M120,748 C108,756 90,765 76,780"></path>
              <!-- links innen -->
              <path class="root" d="M120,748 C113,757 104,767 98,781"></path>
              <!-- Mitte / Pfahlwurzel -->
              <path class="root" d="M120,749 C120,760 119,774 120,788"></path>
              <!-- rechts innen -->
              <path class="root" d="M120,748 C127,757 136,767 142,781"></path>
              <!-- rechts -->
              <path class="root" d="M120,748 C132,756 150,765 164,780"></path>
              <!-- weit rechts außen -->
              <path class="root" d="M120,748 C138,756 160,764 180,782"></path>
            </g>

            <!-- Stiel = wachsender, organisch geschwungener Strahl
                 (unten y=748 → oben y=60). y fällt monoton, damit die
                 Skript-Suche fracAtY sauber funktioniert. -->
            <path
              id="stem"
              d="M120,748 C111,725 111,702 120,679 C129,656 129,633 120,610 C111,587 111,564 120,541 C129,518 129,495 120,472 C111,449 111,426 120,403 C129,380 129,357 120,334 C111,311 111,288 120,265 C129,242 129,219 120,196 C113,173 113,150 120,127 C122,104 121,82 120,60"
            ></path>

            <!-- Weg-Bewuchs: abwechselnd Blätter UND kleine Blüten, links und
                 rechts verteilt. Die kleinen Blüten stehen für die kleinen
                 Erfolge unterwegs; die große Blüte oben ist das Highlight.
                 Alle tragen die Klasse "leaf" + data-y, damit die bestehende
                 Wachstums-Animation sie ohne Skript-Änderung mit einblendet. -->

            <!-- unten: Blatt links (gut sichtbar, aber klein – wächst nach oben) -->
            <g class="leaf" data-y="714">
              <path transform="translate(113,714) rotate(-147) scale(0.85)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- kleine Blüte rechts -->
            <g class="leaf bud bud--orange" data-y="645">
              <g transform="translate(135,645) scale(0.92)">
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(72)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(144)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(216)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(288)"></ellipse>
                <circle class="bud__center" cx="0" cy="0" r="3.8"></circle>
              </g>
            </g>
            <!-- Blatt links -->
            <g class="leaf" data-y="576">
              <path transform="translate(113,576) rotate(-145) scale(1)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- Blatt rechts -->
            <g class="leaf" data-y="507">
              <path transform="translate(127,507) rotate(-37) scale(1.1)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- kleine Blüte links -->
            <g class="leaf bud bud--rose" data-y="438">
              <g transform="translate(104,438) scale(1.24)">
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(72)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(144)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(216)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(288)"></ellipse>
                <circle class="bud__center" cx="0" cy="0" r="3.6"></circle>
              </g>
            </g>
            <!-- Blatt rechts -->
            <g class="leaf" data-y="369">
              <path transform="translate(127,369) rotate(-36) scale(1.3)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- Blatt links -->
            <g class="leaf" data-y="300">
              <path transform="translate(113,300) rotate(-145) scale(1.4)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- kleine Blüte rechts (nach oben größer & schöner) -->
            <g class="leaf bud bud--sun" data-y="231">
              <g transform="translate(136,231) scale(1.45)">
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(72)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(144)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(216)"></ellipse>
                <ellipse class="bud__petal" cx="0" cy="-9" rx="4.6" ry="9" transform="rotate(288)"></ellipse>
                <circle class="bud__center" cx="0" cy="0" r="3.4"></circle>
              </g>
            </g>
            <!-- oben: das größte, schönste Blatt links, kurz vor dem Ziel -->
            <g class="leaf" data-y="164">
              <path transform="translate(117,166) rotate(-150) scale(1.5)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>
            <!-- kleines Akzent-Blatt rechts, tuckt sich seitlich unter die
                 Krone (nach außen gerichtet, verdeckt die Blüte nicht) -->
            <g class="leaf" data-y="110">
              <path transform="translate(126,112) rotate(-22) scale(0.78)"
                d="M0,0 C10,-12 34,-13 50,-2 C36,-2 18,8 0,2 Z"></path>
            </g>

            <!-- Krone: volle, gefüllte Blüte, die den Weg oben krönt.
                 Äußerer + innerer Blütenkranz + warmer Kern mit Highlight. -->
            <g class="bloom" data-bloom>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(0 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(45 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(90 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(135 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(180 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(225 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(270 120 60)"></ellipse>
              <ellipse class="bloom__petal" cx="120" cy="30" rx="11" ry="26" transform="rotate(315 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(22.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(67.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(112.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(157.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(202.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(247.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(292.5 120 60)"></ellipse>
              <ellipse class="bloom__petal bloom__petal--inner" cx="120" cy="44" rx="7" ry="15" transform="rotate(337.5 120 60)"></ellipse>
              <!-- Gelber Kern der Ziel-Blüte -->
              <circle class="bloom__center" cx="120" cy="60" r="10.5"></circle>
              <circle class="bloom__coredot" cx="120" cy="60" r="4.6"></circle>
            </g>

            <!-- Knoten: node-1 unten (01) … node-6 oben (06) -->
            <circle id="node-1" class="node" cx="120" cy="725" r="6.5"></circle>
            <circle id="node-2" class="node" cx="120" cy="604" r="6.5"></circle>
            <circle id="node-3" class="node" cx="120" cy="483" r="6.5"></circle>
            <circle id="node-4" class="node" cx="120" cy="362" r="6.5"></circle>
            <circle id="node-5" class="node" cx="120" cy="241" r="6.5"></circle>
            <circle id="node-6" class="node" cx="120" cy="120" r="6.5"></circle>
          </g>
        </svg>
      </div>

      <!--
        Rechts: vier Schritt-Boxen. DOM-Reihenfolge 01→04 (Lesefluss).
        Im gepinnten Modus wird jede Box per CSS exakt auf ihr Knoten-Verhältnis
        gesetzt (top = cy/760, translateY(-50%)). Die Spalte ist genauso hoch wie
        die SVG (gleicher CSS-Wert) → punktgenau, ohne JS-Messung.
      -->
      <ol class="journey__steps" data-steps>
        {
          steps.map((step) => (
            <li class="journey__step" style={`--top:${step.top}`}>
              <div class="journey__card" data-step>
                <span class="journey__num">{step.num}</span>
                <div class="journey__body">
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .journey {
    /* Reiner weißer Hintergrund: lenkt den Fokus ganz auf die Lebensblume.
       Kein oberer Außenabstand -> kein schmaler leerer Streifen zwischen der
       Themen-Sektion und der weißen Ablauf-Sektion. */
    background: #fff;
    margin-top: 0;

    /* ============ HIER EINSTELLEN ============
       Vertikaler Puffer für Kopf + Abstände + unteren Puffer. Kopf +
       Pflanze + alle 6 Boxen passen zusammen in EINE Bildschirmhöhe.
       Die Pflanze ist oben verankert: oberster Punkt sitzt nah an der
       Überschrift, der freie Rest bleibt als Puffer unten.
       GRÖSSER  = mehr Puffer unten (falls der 1. Punkt gedrückt wirkt).
       KLEINER  = Pflanze höher, Punkte weiter auseinander.
       Sinnvoller Bereich ca. 160–260px. */
    --journey-reserve: 200px;
    /* ========================================= */

    /* Höhe der Pflanze = Höhe der Boxen-Spalte (identischer Wert!).
       Basis = feste, komfortable Höhe für das STATISCHE Overlay (enge/flache
       Screens, ohne Animation) – so haben alle 6 Boxen genug Platz und der
       Text wird nicht beschnitten. Im animierten Pin-Modus (genug Platz) wird
       sie weiter unten auf die Viewport-Höhe umgestellt. */
    --plant-h: 720px;
  }
  .journey__pin {
    /* Basis = statisch (kein Pin): normaler Fluss, das Overlay scrollt einfach
       mit der Seite. Der animierte Pin-Modus überschreibt das weiter unten. */
    display: block;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }
  .journey__pin > * + * {
    margin-top: var(--space-lg);
  }

  /* Kopf zentriert oben */
  .journey__head {
    text-align: center;
    max-width: 60ch;
    margin-top: 0;
  }
  .journey__head h2 {
    margin-bottom: var(--space-sm);
  }
  .journey__head p {
    margin: 0 auto;
    max-width: 52ch;
  }

  /* ===== Layout =====
     Grundprinzip: Die grünen Boxen liegen IMMER als Overlay im Vordergrund
     vor der zentrierten Pflanze – bei enge/flach genauso wie bei viel Platz,
     nur dann eben statisch (ohne Animation). Erst wenn richtig viel Breite UND
     Höhe da ist, wandern die Boxen seitlich neben die Pflanze (weiß, animiert). */

  /* Basis = zentriertes Overlay: Pflanze und Boxen in derselben Rasterzelle. */
  .journey__cols {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    justify-items: stretch;
  }
  .journey__plant,
  .journey__steps {
    grid-column: 1;
    grid-row: 1;
  }
  .journey__steps {
    width: 100%;
    max-width: 540px;
    justify-self: center;
  }

  /* Genug Platz -> animierter Pin-Modus: Pflanze wächst über die volle
     Viewport-Höhe, die Boxen blenden nacheinander ein. */
  @media (min-width: 680px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .journey {
      --plant-h: min(100vh - var(--journey-reserve), 820px);
    }
    .journey__pin {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--space-md);
      padding-bottom: var(--space-md);
    }
    .journey__pin > * + * {
      margin-top: 0;
    }
  }

  /* Sehr breit UND hoch -> Pflanze links, Boxen rechts daneben (kein Overlay). */
  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .journey__cols {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--space-3xl);
      justify-items: stretch;
    }
    .journey__plant {
      grid-column: 1;
    }
    .journey__steps {
      grid-column: 2;
      max-width: none;
      justify-self: stretch;
    }
    /* Boxen stehen hier NEBEN der Pflanze -> normale weiße Füllung.
       Höhere Spezifität als die grüne Basisregel, damit sie sicher greift. */
    .journey__steps .journey__body {
      background: #fff;
      border-color: rgba(133, 124, 117, 0.28);
    }
  }

  /* ---------- Pflanze / SVG ---------- */
  .journey__plant {
    display: flex;
    justify-content: center;
    /* Die Pflanze liegt bewusst HINTER den Boxen (z-index 1 < Boxen z-index 3),
       damit die grünen Boxen mit dem Text immer im Vordergrund stehen. */
    position: relative;
    z-index: 1;
  }
  .journey__plant .plant {
    height: var(--plant-h);
    width: auto;
    /* nichts abschneiden – große Blätter/Blüten dürfen über den Rahmen
       hinausragen und bleiben im Vordergrund. */
    overflow: visible;
  }
  /* Dekorative, auf die "Lebensblume" beschränkte Farben. Bewusst warm/erdig,
     damit es bunt & niedlich wirkt und trotzdem zur Marke passt. */
  .journey__plant {
    --stem-green: #3f6f3c;
    --leaf-green: #6fa06a;
    --bloom-sun: #e6b45a;
    --bloom-rose: #d98c7d;
  }
  .journey__plant .plant__ink {
    stroke: var(--forest-deep);
  }
  /* Grüner, lebendiger Stängel = "Der Weg" */
  .journey__plant #stem {
    stroke: var(--stem-green);
    stroke-width: 4.2;
  }
  /* Wurzeln = "Der Anfang" (die Pflanze bricht aus der Erde) */
  .journey__plant .root {
    fill: none;
    stroke: var(--earth-deep);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .journey__plant .leaf {
    fill: var(--leaf-green);
  }
  /* Kleine, BUNTE Blüten entlang des Weges (die kleinen Erfolge unterwegs) */
  .journey__plant .bud__petal {
    fill: var(--soft-sand);
    stroke: var(--forest-deep);
    stroke-width: 1.2;
  }
  .journey__plant .bud__center {
    fill: var(--accent-pilot);
    stroke: none;
  }
  .journey__plant .bud--orange .bud__petal { fill: var(--accent-pilot); }
  .journey__plant .bud--orange .bud__center { fill: var(--accent-pilot-soft); }
  .journey__plant .bud--rose .bud__petal { fill: var(--bloom-rose); }
  .journey__plant .bud--rose .bud__center { fill: var(--bloom-sun); }
  .journey__plant .bud--sun .bud__petal { fill: var(--bloom-sun); }
  .journey__plant .bud--sun .bud__center { fill: var(--accent-pilot); }
  .journey__plant .node {
    fill: var(--forest-deep);
    stroke: none;
  }
  /* WICHTIG: Knoten und Blüte bekommen hier BEWUSST kein transform-box/
     transform-origin. GSAP schreibt seinen Drehpunkt als Pixelwert im
     SVG-Koordinatensystem (viewBox). Mit "transform-box: fill-box" würde der
     Browser denselben Wert stattdessen ab der linken Kante der jeweiligen
     Bounding-Box messen – der Drehpunkt landete weit rechts vom Element und
     die Blüte flöge beim Aufskalieren seitlich in den Stiel hinein (dasselbe
     galt für die Knotenpunkte).
     Der Drehpunkt wird stattdessen im Skript exakt gesetzt (svgOrigin), für
     die Blüte auf die Stielspitze 120/60 – sie geht also genau dort auf, wo
     der Stiel endet. */
  /* Krone / große Ziel-Blüte = "Das Ziel": farbenfroh */
  .journey__plant .bloom__petal {
    fill: var(--accent-pilot);
    stroke: var(--forest-deep);
    stroke-width: 1.5;
  }
  /* Innerer Blütenkranz: sonnengelb, füllt die Lücken und gibt Tiefe. */
  .journey__plant .bloom__petal--inner {
    fill: var(--bloom-sun);
    stroke: var(--forest-deep);
    stroke-width: 1.2;
  }
  /* Gelber Kern der Ziel-Blüte */
  .journey__plant .bloom__center {
    fill: var(--bloom-sun);
    stroke: var(--forest-deep);
    stroke-width: 1.3;
  }
  .journey__plant .bloom__coredot {
    fill: var(--accent-pilot);
    stroke: none;
  }

  /* ---------- Schritt-Boxen: liegen IMMER als Overlay über der Pflanze ----------
     Gilt animiert UND statisch gleichermaßen: Die Boxen-Spalte ist exakt so
     hoch wie die Pflanze, jede Box sitzt fest auf ihrem Knoten-Verhältnis. */
  .journey__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    height: var(--plant-h);
    z-index: 3; /* Boxen immer im Vordergrund, vor der Pflanze */
  }
  .journey__step {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--top);
    /* Feste Slot-Höhe = Knotenabstand (~15,9 %), minus kleine Lücke -> die
       Boxen können sich bei KEINER Bildschirmgröße überschneiden. */
    height: calc(var(--plant-h) * 0.15);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
  }
  .journey__card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: center;
    width: 100%;
    max-height: 100%;
    /* langer Text (Schritt 5 & 6) läuft nie in die Nachbarbox */
    overflow: hidden;
  }
  .journey__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding-inline: 0.4em;
    border-radius: 999px;
    background: var(--forest-deep);
    color: var(--on-dark);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
  /* Boxen liegen vor der Pflanze -> hellgrüne Füllung, Text hebt sich klar ab.
     (Im seitlichen Layout wird das oben auf Weiß zurückgesetzt.) */
  .journey__body {
    background: #dcead5;
    border-radius: var(--radius);
    border: 1px solid rgba(21, 44, 26, 0.22);
    padding: var(--space-2xs) var(--space-sm);
    box-shadow: var(--shadow-soft);
  }
  .journey__body h3 {
    font-size: 0.9rem;
    margin-bottom: 2px;
  }
  .journey__body p {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.32;
    color: var(--calm-earth);
  }

  /* ==========================================================================
     VARIANTE 3 – schmal ODER flach (Handy, Tablet hochkant, niedrige Fenster).
     Gleiches Bild wie Variante 2 (Boxen als Overlay ueber der Pflanze), aber
     jetzt ebenfalls ANIMIERT statt statisch. Der Unterschied zu Variante 2:
       * Gepinnt wird nur .journey__cols – die Ueberschrift scrollt vorher weg
         und verschenkt keine Hoehe. Dadurch steht die volle Fensterhoehe fuer
         Pflanze + 6 Boxen zur Verfuegung.
       * Alle Maße (Pflanzenhoehe, Slot-Hoehe, Schrift, Innenabstaende) haengen
         an der Fensterhoehe, damit die 6 Boxen auf JEDER Groesse zusammen in
         einen Screen passen und sich nie beruehren.
     Der Block steht bewusst GANZ AM ENDE und greift nur unterhalb der
     Schwellen von Variante 1 + 2 – die beiden bleiben unberuehrt.
     ========================================================================== */
  @media (max-width: 679.98px), (max-height: 699.98px) {
    .journey {
      /* Reserve = Sticky-Navbar (76px) + etwas Luft unten. Der Kopf ist hier
         NICHT im Lock, taucht also nicht in der Rechnung auf. */
      --plant-h: calc(100svh - 104px);
    }
    .journey__pin {
      padding-top: var(--space-md);
      padding-bottom: var(--space-2xl);
    }
    /* Etwas schmalerer Seitenabstand → mehr Textbreite pro Box. */
    .journey__cols {
      padding-inline: var(--space-md);
    }
    .journey__steps {
      max-width: 540px;
    }

    /* Slot-Hoehe knapp unter dem Knotenabstand (15,9 %): garantiert eine
       sichtbare Luecke zwischen zwei benachbarten Boxen. */
    .journey__step {
      height: calc(var(--plant-h) * 0.149);
    }

    /* Kompakte Typo, damit auch der laengste Text (06) in seinen Slot passt. */
    .journey__card {
      column-gap: var(--space-2xs);
    }
    .journey__num {
      min-width: 26px;
      height: 26px;
      font-size: 0.6rem;
    }
    .journey__body {
      padding: 5px var(--space-xs);
    }
    .journey__body h3 {
      font-size: 0.8rem;
      line-height: 1.18;
      margin-bottom: 1px;
    }
    .journey__body p {
      font-size: 0.68rem;
      line-height: 1.26;
    }
  }

  /* Sehr kleine bzw. sehr flache Fenster: noch eine Stufe kompakter. */
  @media (max-width: 380px), (max-height: 620px) {
    .journey__body h3 {
      font-size: 0.74rem;
    }
    .journey__body p {
      font-size: 0.63rem;
      line-height: 1.22;
    }
    .journey__num {
      min-width: 22px;
      height: 22px;
      font-size: 0.55rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    const pin = root.querySelector<HTMLElement>('[data-pin]')!;
    const steps = root.querySelector<HTMLElement>('[data-steps]')!;
    const stem = root.querySelector<SVGPathElement>('#stem')!;
    const leaves = gsap.utils.toArray<SVGGElement>('.leaf', root);
    const nodes = [1, 2, 3, 4, 5, 6].map(
      (n) => root.querySelector<SVGCircleElement>('#node-' + n)!
    );
    const boxes = gsap.utils.toArray<HTMLElement>('[data-step]', root);
    const bloom = root.querySelector<SVGGElement>('[data-bloom]')!;

    /**
     * Skaliert ein SVG-Element um einen EXAKTEN Punkt der viewBox und schreibt
     * den Transform direkt als Attribut.
     * Warum nicht einfach gsap {scale}? GSAP legt seinen Drehpunkt fuer SVG als
     * Pixelwert ab; je nach transform-box misst der Browser diesen Wert ab der
     * Bounding-Box statt im SVG-Raster. Der Drehpunkt sass dadurch neben dem
     * Element - die Bluete flog beim Aufgehen seitlich in den Stiel hinein und
     * auch die Knotenpunkte rutschten waehrend des Einblendens zur Seite.
     * Mit translate/scale/translate ist der Drehpunkt fix und browserunabhaengig.
     */
    const growAbout = (el: SVGElement, cx: number, cy: number, from: number) => {
      const state = { s: from };
      const apply = () =>
        el.setAttribute(
          'transform',
          `translate(${cx} ${cy}) scale(${state.s}) translate(${-cx} ${-cy})`
        );
      apply();
      return { state, apply, reset: () => el.removeAttribute('transform') };
    };

    const mm = gsap.matchMedia();

    // Ab 680px Breite UND 700px Höhe, ohne reduzierte Bewegung: gepinnte
    // Scroll-Animation. Das Layout (zentriertes Overlay vs. Pflanze links /
    // Boxen rechts) steuert allein das CSS. Darunter zeigt das CSS dasselbe
    // Overlay einfach STATISCH (Boxen sichtbar, kein Pin, scrollt normal).
    mm.add(
      '(min-width: 680px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)',
      () => {
        const L = stem.getTotalLength();

        // Längen-Anteil (0..1), an dem die Stem-Spitze die Höhe y passiert.
        // y fällt monoton entlang des Pfades (748 → 28).
        const fracAtY = (y: number) => {
          let lo = 0;
          let hi = L;
          for (let i = 0; i < 24; i++) {
            const mid = (lo + hi) / 2;
            if (stem.getPointAtLength(mid).y > y) lo = mid;
            else hi = mid;
          }
          return (lo + hi) / 2 / L;
        };

        // Layout (Overlay bzw. seitlich) steuert komplett das CSS. Diese Klasse
        // markiert nur den animierten Zustand (falls später gebraucht).
        steps.classList.add('is-pinned');

        // Startzustände der Animation
        gsap.set(stem, { strokeDasharray: L, strokeDashoffset: L });
        gsap.set(leaves, { opacity: 0 });
        gsap.set(nodes, { opacity: 0 });
        gsap.set(boxes, { opacity: 0, x: 24 });
        gsap.set(bloom, { opacity: 1 });
        // Knoten wachsen um ihren eigenen Mittelpunkt, die Bluete exakt um die
        // Stielspitze (120/60) - sie geht also genau dort auf, wo der Stiel endet.
        const nodeGrows = nodes.map((node) =>
          growAbout(node, 120, Number(node.getAttribute('cy')), 0.2)
        );
        const bloomGrow = growAbout(bloom, 120, 60, 0);

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            // Lock etwas höher: Pin rastet ein, wenn die Sektion noch ~48px
            // unter dem oberen Rand steht → kleiner Freiraum über "Der Ablauf".
            trigger: pin,
            start: 'top top+=60',
            end: () => '+=' + window.innerHeight * 3,
            pin: true,
            scrub: true,
            invalidateOnRefresh: true,
          },
        });

        // Stiel zeichnet sich von unten nach oben über den gesamten Scrollweg.
        tl.to(stem, { strokeDashoffset: 0, duration: 1 }, 0);

        // Blätter faden ein, sobald die Spitze sie passiert.
        leaves.forEach((leaf) => {
          const y = Number(leaf.dataset.y);
          tl.to(leaf, { opacity: 1, duration: 0.06 }, fracAtY(y));
        });

        // Knoten + zugehörige Box erscheinen, wenn die Spitze den Knoten erreicht.
        boxes.forEach((box, i) => {
          const at = fracAtY(Number(nodes[i].getAttribute('cy')));
          tl.to(nodes[i], { opacity: 1, duration: 0.04 }, at);
          tl.to(
            nodeGrows[i].state,
            { s: 1, duration: 0.04, onUpdate: nodeGrows[i].apply },
            at
          );
          tl.to(
            box,
            { opacity: 1, x: 0, duration: 0.12, ease: 'power2.out' },
            at
          );
        });

        // Krone: Knospe erblüht erst, wenn der Stiel voll ausgefahren ist -
        // aufgehend an der Stielspitze, ohne seitliche Bewegung.
        tl.to(
          bloomGrow.state,
          {
            s: 1,
            duration: 0.25,
            ease: 'back.out(1.7)',
            onUpdate: bloomGrow.apply,
          },
          1
        );

        // Pin-Start/-Ende mit finalen Maßen rechnen, sobald Layout/Fonts stehen.
        let active = true;
        const refresh = () => {
          if (active) ScrollTrigger.refresh();
        };
        const fontsReady: Promise<unknown> =
          (document as any).fonts?.ready ?? Promise.resolve();
        fontsReady.then(() => requestAnimationFrame(refresh));
        window.addEventListener('load', refresh);

        return () => {
          active = false;
          window.removeEventListener('load', refresh);
          steps.classList.remove('is-pinned');
          // manuell gesetzte Transform-Attribute wieder entfernen
          bloomGrow.reset();
          nodeGrows.forEach((g) => g.reset());
        };
      }
    );

    // ------------------------------------------------------------------
    // VARIANTE 3 - schmal ODER flach: gleiches Overlay-Bild wie Variante 2,
    // jetzt aber ebenfalls gepinnt und animiert. Gepinnt wird nur die
    // Spalten-Box (nicht der Kopf) - so bleibt die ganze Fensterhoehe fuer
    // Pflanze + Boxen uebrig und nichts ueberschneidet sich.
    // Bewusst eigener Block: Variante 1 + 2 oben bleiben unangetastet.
    // ------------------------------------------------------------------
    mm.add(
      '(prefers-reduced-motion: no-preference) and (max-width: 679.98px), (prefers-reduced-motion: no-preference) and (max-height: 699.98px)',
      () => {
        const cols = root.querySelector<HTMLElement>('.journey__cols')!;
        const L = stem.getTotalLength();

        const fracAtY = (y: number) => {
          let lo = 0;
          let hi = L;
          for (let i = 0; i < 24; i++) {
            const mid = (lo + hi) / 2;
            if (stem.getPointAtLength(mid).y > y) lo = mid;
            else hi = mid;
          }
          return (lo + hi) / 2 / L;
        };

        // Anteil des Scrollwegs fuers Stiel-Wachstum, Rest gehoert der Bluete.
        const GROW = 0.86;

        gsap.set(stem, { strokeDasharray: L, strokeDashoffset: L });
        gsap.set(leaves, { opacity: 0 });
        gsap.set(nodes, { opacity: 0 });
        gsap.set(bloom, { opacity: 1 });
        // wie oben: Drehpunkte exakt auf Knoten bzw. Stielspitze
        const nodeGrows = nodes.map((node) =>
          growAbout(node, 120, Number(node.getAttribute('cy')), 0.2)
        );
        const bloomGrow = growAbout(bloom, 120, 60, 0);
        // Boxen kommen hier von unten statt von rechts - passt besser zum
        // schmalen Hochformat.
        gsap.set(boxes, { opacity: 0, y: 14 });

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: cols,
            // direkt unter der 76px hohen Sticky-Navbar einrasten
            start: 'top top+=84',
            end: () => '+=' + window.innerHeight * 2.4,
            pin: true,
            scrub: true,
            invalidateOnRefresh: true,
          },
        });

        tl.to(stem, { strokeDashoffset: 0, duration: GROW }, 0);

        leaves.forEach((leaf) => {
          tl.to(
            leaf,
            { opacity: 1, duration: 0.05 },
            fracAtY(Number(leaf.dataset.y)) * GROW
          );
        });

        boxes.forEach((box, i) => {
          const at = fracAtY(Number(nodes[i].getAttribute('cy'))) * GROW;
          tl.to(nodes[i], { opacity: 1, duration: 0.04 }, at);
          tl.to(
            nodeGrows[i].state,
            { s: 1, duration: 0.04, onUpdate: nodeGrows[i].apply },
            at
          );
          tl.to(
            box,
            { opacity: 1, y: 0, duration: 0.1, ease: 'power2.out' },
            at
          );
        });

        tl.to(
          bloomGrow.state,
          {
            s: 1,
            duration: 1 - GROW,
            ease: 'back.out(1.7)',
            onUpdate: bloomGrow.apply,
          },
          GROW
        );

        let active = true;
        const refresh = () => {
          if (active) ScrollTrigger.refresh();
        };
        const fontsReady: Promise<unknown> =
          (document as any).fonts?.ready ?? Promise.resolve();
        fontsReady.then(() => requestAnimationFrame(refresh));
        window.addEventListener('load', refresh);

        return () => {
          active = false;
          window.removeEventListener('load', refresh);
          bloomGrow.reset();
          nodeGrows.forEach((g) => g.reset());
        };
      }
    );
  }
</script>
