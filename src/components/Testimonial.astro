---
interface Props {
  quote: string;
  /** Anonymisierter Autor ohne Namen, z. B. "Kundin, 34". */
  author: string;
  /** Optionale Themenzeile, z. B. "Thema: Abnehmen". */
  topic?: string;
  /** Optionaler Begleitungszeitraum, z. B. "Begleitung: 2026". */
  period?: string;
  /** Optionale Sternebewertung 1–5. Ohne Angabe werden keine Sterne gezeigt. */
  rating?: number;
  /** Barrierefreies Label für die Sterne, z. B. "5 von 5 Sternen". */
  ratingLabel?: string;
}
const { quote, author, topic, period, rating, ratingLabel } = Astro.props;
const stars = rating ? Math.round(Math.min(Math.max(rating, 0), 5)) : 0;
---

<figure class="testimonial">
  {
    stars > 0 && (
      <p class="testimonial__rating" aria-label={ratingLabel}>
        {Array.from({ length: 5 }, (_, i) => (
          <svg
            class:list={['testimonial__star', i >= stars && 'testimonial__star--empty']}
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45 6.19 20.5 7.3 14.03 2.6 9.45l6.5-.95L12 2.6z" />
          </svg>
        ))}
      </p>
    )
  }
  <blockquote class="testimonial__quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="testimonial__author">
    <span class="testimonial__author-name">{author}</span>
    {topic && <span class="testimonial__author-context">{topic}</span>}
    {period && <span class="testimonial__author-context">{period}</span>}
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    background: #fff;
    border-radius: var(--radius);
    border: var(--border-soft);
    box-shadow: var(--shadow-soft);
    padding: var(--space-xl);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .testimonial__rating {
    display: flex;
    gap: 0.15em;
    margin: 0 0 var(--space-xs);
  }
  .testimonial__star {
    width: 1.15rem;
    height: 1.15rem;
    fill: #e0a02a;
  }
  .testimonial__star--empty {
    fill: var(--sage-harmony);
    opacity: 0.5;
  }
  /* Ohne Sterne braucht das Zitat oben Platz für das große Anführungszeichen,
     mit Sterne-Zeile sitzt es sonst zu tief. */
  .testimonial__rating + .testimonial__quote {
    padding-top: var(--space-sm);
  }
  .testimonial__quote {
    margin: 0 0 var(--space-lg);
    position: relative;
    padding-top: var(--space-lg);
  }
  .testimonial__quote::before {
    content: '“';
    position: absolute;
    top: -0.2em;
    left: -0.05em;
    font-family: var(--font-heading);
    font-size: 3.4rem;
    line-height: 1;
    color: var(--sage-harmony);
  }
  .testimonial__quote p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    font-style: italic;
  }
  .testimonial__author {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }
  .testimonial__author-name {
    font-weight: 600;
    color: var(--calm-earth);
  }
  .testimonial__author-context {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--calm-earth);
    opacity: 0.75;
  }
</style>
