---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../TopicCard.astro';
import portraitImg from '../../assets/about/portrait.jpg';
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';

// Skizzen für die Themen-Karten (transparente PNGs, dunkelgrüne Striche).
// Reihenfolge = Reihenfolge von topicsContent.items.
import imgMitarbeiter from '../../assets/topics/corp-mitarbeiterdynamiken.png';
import imgGesundheit from '../../assets/topics/corp-gesundheitsmanagement.png';
import imgLeistungsdruck from '../../assets/topics/corp-leistungsdruck.png';
import imgMeinungen from '../../assets/topics/corp-meinungsverschiedenheiten.png';
import imgFuehrung from '../../assets/topics/corp-fuehrungsdynamiken.png';
import imgAutonomie from '../../assets/topics/corp-autonomie.png';

const topicImages = [
  imgMitarbeiter,    // Mitarbeiterdynamiken
  imgGesundheit,     // Gesundheitsmanagement
  imgLeistungsdruck, // Leistungsdruck
  imgMeinungen,      // Meinungsverschiedenheiten
  imgFuehrung,       // Führungsdynamiken
  imgAutonomie,      // Autonomie vs. Kontrolle
];

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const contactHref = localizePath('/kontakt', lang) + '#buchung';
const faqHref = localizePath('/preise', lang) + '#faq';

const pillars = ['1', '2', '3'] as const;
const offers = ['1', '2', '3', '4'] as const;
const steps = ['1', '2', '3'] as const;

// "Weitere mögliche Themen" – Karten-Slider analog zur Coaching-Seite.
// Bewusst hier als Liste lokalisiert (statt flacher i18n-Schlüssel).
const topicsContent =
  lang === 'en'
    ? {
        eyebrow: 'More topics',
        title: 'Further possible topics',
        lead: 'The possibilities are endless – get in touch!',
        prev: 'Previous topic',
        next: 'Next topic',
        items: [
          {
            title: 'Team dynamics',
            text: 'Recognise recurring patterns within the team and shape collaboration consciously – for a way of working together that holds.',
          },
          {
            title: 'Health management',
            text: 'Spot strain early and counteract it deliberately – from preventive measures to concrete support when it really matters.',
          },
          {
            title: 'Performance pressure',
            text: 'Deal more calmly with high expectations and enable performance without constantly operating at the limit.',
          },
          {
            title: 'Disagreements',
            text: 'Resolve conflicts constructively and use differing perspectives as an opportunity for better solutions.',
          },
          {
            title: 'Leadership dynamics',
            text: 'Reflect on roles, responsibility and leadership behaviour – for clear, appreciative and effective leadership.',
          },
          {
            title: 'Autonomy vs. control',
            text: 'Find the balance between self-responsibility and steering that builds trust and secures results.',
          },
        ],
      }
    : {
        eyebrow: 'Weitere Themen',
        title: 'Weitere mögliche Themen',
        lead: 'Die Möglichkeiten sind grenzenlos – sprechen Sie mich an!',
        prev: 'Vorheriges Thema',
        next: 'Nächstes Thema',
        items: [
          {
            title: 'Mitarbeiterdynamiken',
            text: 'Wiederkehrende Muster im Team erkennen und die Zusammenarbeit bewusst gestalten – für ein Miteinander, das trägt.',
          },
          {
            title: 'Gesundheitsmanagement',
            text: 'Belastungen früh erkennen und gezielt gegensteuern – von vorbeugenden Maßnahmen bis zur konkreten Begleitung im Ernstfall.',
          },
          {
            title: 'Leistungsdruck',
            text: 'Mit hohen Erwartungen gelassener umgehen und Leistung ermöglichen, ohne dauerhaft an die Belastungsgrenze zu gehen.',
          },
          {
            title: 'Konflikte proaktiv lösen',
            text: 'Konflikte konstruktiv klären und unterschiedliche Sichtweisen als Chance für bessere Lösungen nutzen.',
          },
          {
            title: 'Führungsdynamiken',
            text: 'Rollen, Verantwortung und Führungsverhalten reflektieren – für klare, wertschätzende und wirksame Führung.',
          },
          {
            title: 'Autonomie vs. Kontrolle',
            text: 'Die Balance zwischen Eigenverantwortung und Steuerung finden, die Vertrauen schafft und Ergebnisse sichert.',
          },
        ],
      };

// Direktkontakt-Block – inhaltlich identisch zur Kontaktseite ("Kontaktiere
// mich direkt"), hier auf dunkelgrüner Fläche am Seitenende.
const directContent =
  lang === 'en'
    ? {
        title: 'Contact me directly',
        email: 'Email',
        emailNote: '[PLACEHOLDER: confirm final email address]',
        instagram: 'Instagram',
        instagramHandle: '@evoqueyourself',
        portraitAlt: 'Malin – EVOQUE',
        cardAlt: 'QR code to the EVOQUE Instagram profile',
        igTitle: 'EVOQUE on Instagram',
        faqPrompt: 'Still have open questions?',
        faqCta: 'To the FAQ',
      }
    : {
        title: 'Kontaktiere mich direkt',
        email: 'E-Mail',
        emailNote: '[PLATZHALTER: finale E-Mail-Adresse bestätigen]',
        instagram: 'Instagram',
        instagramHandle: '@evoqueyourself',
        portraitAlt: 'Malin – EVOQUE',
        cardAlt: 'QR-Code zum EVOQUE Instagram-Profil',
        igTitle: 'EVOQUE auf Instagram',
        faqPrompt: 'Noch Fragen offen?',
        faqCta: "Zu den FAQ's",
      };
const instagramUrl = 'https://www.instagram.com/evoqueyourself';
---

<BaseLayout title={t('company.meta.title')} description={t('company.meta.description')}>
  <div class="corp">
    <!-- Hero -->
    <section class="corp-hero">
      <div class="container corp-hero__inner">
        <p class="corp-eyebrow corp-eyebrow--light">{t('company.hero.eyebrow')}</p>
        <h1 class="corp-hero__title">{t('company.hero.title')}</h1>
        <p class="corp-hero__text">{t('company.hero.text')}</p>
        <div class="corp-hero__actions">
          <a href={contactHref} class="corp-btn corp-btn--primary">{t('company.hero.cta')}</a>
          <a href="#leistungen" class="corp-btn corp-btn--ghost">{t('company.hero.ctaSecondary')}</a>
        </div>
      </div>
    </section>

    <!-- Werte / Pillars -->
    <section class="corp-section">
      <div class="container corp-pillars">
        {
          pillars.map((n) => (
            <div class="corp-pillar">
              <span class="corp-pillar__rule" aria-hidden="true" />
              <h2 class="corp-pillar__title">{t(`company.pillars.${n}.title` as any)}</h2>
              <p class="corp-pillar__text">{t(`company.pillars.${n}.text` as any)}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Leistungen -->
    <section id="leistungen" class="corp-section corp-section--alt">
      <div class="container">
        <header class="corp-head">
          <p class="corp-eyebrow">{t('company.offer.eyebrow')}</p>
          <h2 class="corp-head__title">{t('company.offer.title')}</h2>
          <p class="corp-head__lead">{t('company.offer.lead')}</p>
        </header>
        <div class="corp-grid">
          {
            offers.map((n) => (
              <article class="corp-card">
                <h3 class="corp-card__title">{t(`company.offer.${n}.title` as any)}</h3>
                <p class="corp-card__text">{t(`company.offer.${n}.text` as any)}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Weitere mögliche Themen (Karten-Slider) -->
    <section class="corp-section corp-topics" id="themen">
      <div class="container">
        <header class="corp-head">
          <p class="corp-eyebrow">{topicsContent.eyebrow}</p>
          <h2 class="corp-head__title">{topicsContent.title}</h2>
          <p class="corp-head__lead">{topicsContent.lead}</p>
        </header>

        <div
          class="topic-slider"
          data-topic-slider
          role="group"
          aria-roledescription="Karussell"
          aria-label={topicsContent.title}
        >
          <div class="topic-slider__viewport" data-viewport>
            <div class="topic-slider__track" data-track>
              {
                topicsContent.items.map((topic, i) => (
                  <div class="topic-slider__slide">
                    <TopicCard title={topic.title} image={topicImages[i]}>
                      {topic.text}
                    </TopicCard>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="topic-slider__controls">
            <button
              type="button"
              class="topic-slider__nav"
              data-prev
              aria-label={topicsContent.prev}
            >
              ‹
            </button>
            <div class="topic-slider__dots" data-dots aria-hidden="true"></div>
            <button
              type="button"
              class="topic-slider__nav"
              data-next
              aria-label={topicsContent.next}
            >
              ›
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Vorgehen -->
    <section class="corp-section corp-section--alt">
      <div class="container">
        <header class="corp-head">
          <p class="corp-eyebrow">{t('company.approach.eyebrow')}</p>
          <h2 class="corp-head__title">{t('company.approach.title')}</h2>
        </header>
        <ol class="corp-steps">
          {
            steps.map((n, i) => (
              <li class="corp-step">
                <span class="corp-step__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="corp-step__title">{t(`company.approach.${n}.title` as any)}</h3>
                <p class="corp-step__text">{t(`company.approach.${n}.text` as any)}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Direktkontakt (helles Grün wie der Start-CTA-Button unten) -->
    <section class="corp-section corp-contact">
      <div class="container">
        <h2 class="corp-contact__title">{directContent.title}</h2>

        <div class="contact-box">
          <div class="contact-direct">
            <article class="card contact-person">
              <div class="contact-person__avatar">
                <Image
                  src={portraitImg}
                  alt={directContent.portraitAlt}
                  widths={[300, 480]}
                  sizes="150px"
                  quality={85}
                  loading="lazy"
                />
              </div>
              <dl class="contact-list">
                <div>
                  <dt>{directContent.email}</dt>
                  <dd>
                    <a href="mailto:evoqueyourself.coaching@gmail.com"
                      >evoqueyourself.coaching@gmail.com</a
                    >
                    <span class="contact-note">{directContent.emailNote}</span>
                  </dd>
                </div>
                <div>
                  <dt>{directContent.instagram}</dt>
                  <dd>
                    <a href={instagramUrl} target="_blank" rel="noopener"
                      >{directContent.instagramHandle}</a
                    >
                  </dd>
                </div>
              </dl>
            </article>

            <div class="ig-embed">
              <iframe
                src="https://www.instagram.com/evoqueyourself/embed"
                title={directContent.igTitle}
                loading="lazy"
                scrolling="no"
                frameborder="0"
                allowtransparency="true"
              ></iframe>
            </div>
          </div>

          <p class="contact-faq">
            <span class="contact-faq__prompt">{directContent.faqPrompt}</span>
            <a href={faqHref} class="btn btn--primary">{directContent.faqCta}</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* =====================================================================
     Corporate-Stil – bewusst sachlicher als der Rest der Seite:
     Body-Schrift für Überschriften, kantigere Radien, klare Raster,
     viel Weißraum. Nutzt ausschließlich die Markenfarben.
     ===================================================================== */
  .corp {
    --corp-radius: 4px;
    --corp-line: rgba(21, 44, 26, 0.12);
  }
  .corp :global(h1),
  .corp :global(h2),
  .corp :global(h3) {
    font-family: var(--font-body);
    letter-spacing: -0.01em;
  }

  .corp-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--calm-earth);
    margin: 0 0 var(--space-sm);
  }
  .corp-eyebrow--light {
    color: var(--sage-harmony);
  }

  /* ---------- Buttons (kantig, sachlich) ---------- */
  .corp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85em 1.6em;
    border-radius: var(--corp-radius);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .corp-btn--primary {
    background: var(--sage-harmony);
    color: var(--forest-deep);
  }
  .corp-btn--primary:hover {
    background: #c0cfc3;
  }
  .corp-btn--ghost {
    border-color: rgba(243, 239, 233, 0.4);
    color: var(--on-dark);
  }
  .corp-btn--ghost:hover {
    border-color: var(--on-dark);
  }

  /* ---------- Hero (dunkel) ---------- */
  .corp-hero {
    background: var(--forest-deep);
    color: var(--on-dark);
  }
  .corp-hero__inner {
    padding-block: clamp(3.5rem, 9vw, 7rem);
    max-width: 60ch;
  }
  .corp-hero__title {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.1;
    margin: 0 0 var(--space-lg);
    color: #fff;
  }
  .corp-hero__text {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--sage-harmony);
    margin: 0 0 var(--space-xl);
  }
  .corp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* ---------- Sektion-Grundlayout ---------- */
  .corp-section {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .corp-section--alt {
    background: var(--soft-sand);
  }
  .corp-head {
    max-width: 56ch;
    margin-bottom: var(--space-2xl);
  }
  .corp-head__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    color: var(--forest-deep);
  }
  .corp-head__lead {
    margin: 0;
    color: var(--calm-earth);
    font-size: 1.05rem;
  }

  /* ---------- Pillars ---------- */
  .corp-pillars {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 760px) {
    .corp-pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }
  .corp-pillar__rule {
    display: block;
    width: 40px;
    height: 3px;
    background: var(--sage-harmony);
    margin-bottom: var(--space-md);
  }
  .corp-pillar__title {
    font-size: 1.2rem;
    margin: 0 0 var(--space-xs);
    color: var(--forest-deep);
  }
  .corp-pillar__text {
    margin: 0;
    color: var(--calm-earth);
    line-height: 1.6;
  }

  /* ---------- Leistungs-Karten ---------- */
  .corp-grid {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 760px) {
    .corp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .corp-card {
    background: #fff;
    border: 1px solid var(--corp-line);
    border-radius: var(--corp-radius);
    padding: var(--space-xl);
    height: 100%;
  }
  .corp-card__title {
    font-size: 1.15rem;
    margin: 0 0 var(--space-sm);
    color: var(--forest-deep);
  }
  .corp-card__text {
    margin: 0;
    color: var(--calm-earth);
    line-height: 1.6;
  }

  /* ---------- Vorgehen / Steps ---------- */
  .corp-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
    counter-reset: step;
  }
  @media (min-width: 760px) {
    .corp-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }
  .corp-step {
    border-top: 1px solid var(--corp-line);
    padding-top: var(--space-md);
  }
  .corp-step__num {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--sage-harmony);
    margin-bottom: var(--space-sm);
  }
  .corp-step__title {
    font-size: 1.15rem;
    margin: 0 0 var(--space-xs);
    color: var(--forest-deep);
  }
  .corp-step__text {
    margin: 0;
    color: var(--calm-earth);
    line-height: 1.6;
  }

  /* ===== Weitere Themen: Karten-Slider (wie Coaching-Seite) ===== */
  .topic-slider {
    margin-top: var(--space-md);
  }
  .topic-slider__viewport {
    position: relative;
    overflow: hidden;
  }
  /* Fade rechts: deutet an, dass noch eine weitere Karte folgt.
     Ausblenden zur Sektionsfarbe (--bg). */
  .topic-slider__viewport::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 14%;
    max-width: 120px;
    background: linear-gradient(to right, rgba(242, 237, 227, 0), var(--bg));
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.35s ease;
    z-index: 2;
  }
  .topic-slider.is-end .topic-slider__viewport::after {
    opacity: 0;
  }
  .topic-slider__track {
    display: flex;
    gap: var(--space-lg);
    align-items: stretch;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  /* Mobil: 1 Karte + Andeutung der nächsten */
  .topic-slider__slide {
    flex: 0 0 82%;
    min-width: 0;
  }
  /* Tablet: 2 Karten + Andeutung */
  @media (min-width: 560px) {
    .topic-slider__slide {
      flex-basis: 46%;
    }
  }
  /* Desktop: 3 Karten + die vierte rechts angedeutet */
  @media (min-width: 900px) {
    .topic-slider__slide {
      flex-basis: 30%;
    }
  }

  .topic-slider__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .topic-slider__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border: none;
    border-radius: 999px;
    background: var(--forest-deep);
    color: var(--on-dark);
    font-size: 1.6rem;
    line-height: 1;
    padding-bottom: 0.12em;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease,
      opacity 0.2s ease;
  }
  .topic-slider__nav:hover {
    background: #0e2113;
    transform: translateY(-2px);
  }
  .topic-slider__dots {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  /* Die Punkte werden per JS erzeugt und tragen daher kein Astro-Scope-
     Attribut – deshalb :global(). */
  .topic-slider__dots :global(.topic-slider__dot) {
    width: 9px;
    height: 9px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(21, 44, 26, 0.22);
    cursor: pointer;
    transition: background-color 0.2s ease, width 0.2s ease;
  }
  .topic-slider__dots :global(.topic-slider__dot:hover) {
    background: rgba(21, 44, 26, 0.45);
  }
  .topic-slider__dots :global(.topic-slider__dot[aria-current='true']) {
    width: 26px;
    background: var(--forest-deep);
  }

  /* ===== Direktkontakt (weiße Sektion, grüne Daten-Box) ===== */
  .corp-contact {
    background: #fff;
    color: var(--forest-deep);
  }
  .corp-contact__title {
    text-align: center;
    margin-bottom: var(--space-lg);
    color: var(--forest-deep);
  }

  /* Große Box rund um den Direktkontakt-Bereich – in Sage-Grün */
  .contact-box {
    max-width: 720px;
    margin-inline: auto;
    background: var(--sage-harmony);
    border: var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-lg);
  }

  /* FAQ-Verweis unter beiden Karten (in der grünen Box), Text links,
     Button rechts – auf schmalen Bildschirmen bricht er um. */
  .contact-faq {
    margin: var(--space-lg) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    text-align: center;
  }
  .contact-faq__prompt {
    color: var(--forest-deep);
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Zwei Spalten: links Personen-Karte, rechts QR-Code */
  .contact-direct {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 760px) {
    .contact-direct {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  /* Linke Karte mit Foto-Kreis oben */
  .contact-person {
    text-align: center;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }
  .contact-person__avatar {
    width: 140px;
    height: 140px;
    border-radius: 999px;
    overflow: hidden;
    border: 3px solid var(--sage-harmony);
    box-shadow: var(--shadow-soft);
  }
  .contact-person__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .contact-list {
    margin: 0;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
  }
  .contact-list dt {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--calm-earth);
    margin-bottom: var(--space-2xs);
  }
  .contact-list dd {
    margin: 0;
    font-size: 1.1rem;
    color: var(--forest-deep);
  }
  .contact-list a {
    color: var(--forest-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-note {
    display: block;
    font-size: 0.82rem;
    color: var(--calm-earth);
  }

  /* Instagram-Feed-Einbettung (rechte Spalte, statt QR-Code). Breite begrenzt
     -> Inhaltshöhe bleibt vorhersehbar; zusammen mit scrolling="no" am Iframe
     verhindert das den internen Scrollbalken. */
  .ig-embed {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    border: var(--border-soft);
    background: #fff;
  }
  .ig-embed iframe {
    display: block;
    width: 100%;
    border: 0;
    /* Höhe passend zum Instagram-Profil-Embed (kein interner Scroll).
       Bei Bedarf hier fein justieren. */
    height: 540px;
  }
</style>

<script>
  // Themen-Slider: läuft automatisch von links nach rechts, kann aber per
  // Pfeilen, Punkten und Wischgeste manuell bedient werden. (analog Coaching)
  const slider = document.querySelector<HTMLElement>('[data-topic-slider]');
  if (slider) {
    const viewport = slider.querySelector<HTMLElement>('[data-viewport]')!;
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prevBtn = slider.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = slider.querySelector<HTMLButtonElement>('[data-next]')!;
    const dotsWrap = slider.querySelector<HTMLElement>('[data-dots]')!;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    const AUTOPLAY_MS = 2800;
    const RESUME_MS = 10000;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let resumeTimer: ReturnType<typeof setTimeout> | undefined;

    const dots = slides.map((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'topic-slider__dot';
      dot.setAttribute('aria-label', `Thema ${i + 1} anzeigen`);
      dot.addEventListener('click', () => {
        goTo(i);
        scheduleResume();
      });
      dotsWrap.appendChild(dot);
      return dot;
    });

    function maxOffset() {
      return Math.max(0, track.scrollWidth - viewport.clientWidth);
    }

    function lastIndex() {
      const max = maxOffset();
      for (let i = 0; i < slides.length; i++) {
        if (slides[i].offsetLeft >= max - 1) return i;
      }
      return slides.length - 1;
    }

    function goTo(i: number) {
      const last = lastIndex();
      if (i > last) i = 0;
      if (i < 0) i = last;
      index = i;
      const max = maxOffset();
      const x = Math.min(slides[i].offsetLeft, max);
      track.style.transform = `translateX(${-x}px)`;
      // Punkte hinter dem letzten anfahrbaren Index ausblenden – sie werden
      // nie aktiv, weil dort bereits das Track-Ende erreicht ist.
      dots.forEach((d, di) => {
        d.hidden = di > last;
        d.setAttribute('aria-current', di === index ? 'true' : 'false');
      });
      slider!.classList.toggle('is-end', x >= max - 1);
    }

    function next() {
      goTo(index + 1);
    }
    function prev() {
      goTo(index - 1);
    }

    function play() {
      if (resumeTimer) {
        clearTimeout(resumeTimer);
        resumeTimer = undefined;
      }
      if (reduceMotion || timer) return;
      timer = setInterval(next, AUTOPLAY_MS);
    }
    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }
    function scheduleResume() {
      stop();
      if (resumeTimer) clearTimeout(resumeTimer);
      if (reduceMotion) return;
      resumeTimer = setTimeout(play, RESUME_MS);
    }

    nextBtn.addEventListener('click', () => {
      next();
      scheduleResume();
    });
    prevBtn.addEventListener('click', () => {
      prev();
      scheduleResume();
    });

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', scheduleResume);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', scheduleResume);

    let startX = 0;
    let dragging = false;
    viewport.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        dragging = true;
        stop();
      },
      { passive: true }
    );
    viewport.addEventListener(
      'touchend',
      (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) {
          dx < 0 ? next() : prev();
        }
        scheduleResume();
      },
      { passive: true }
    );

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => goTo(index), 150);
    });

    goTo(0);
    play();
  }
</script>
