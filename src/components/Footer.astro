---
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import logo from '../assets/logos/footer.png';
import vemoLogo from '../assets/logos/vemo-logo-mit-schrift.svg';

const year = 2026;
const lang = (Astro.currentLocale ?? 'de') as Lang;
const t = useTranslations(lang);
const l = (p: string) => localizePath(p, lang);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img
        src={logo.src}
        alt="EVOQUE Yourself – Coaching"
        width="120"
        height="116"
        class="site-footer__logo"
      />
      <p class="site-footer__tagline">
        {t('footer.tagline')}
      </p>
    </div>

    <nav class="site-footer__nav" aria-label={t('footer.pages')}>
      <h2 class="site-footer__heading">{t('footer.pages')}</h2>
      <ul>
        <li><a href={l('/')}>{t('nav.start')}</a></li>
        <li><a href={l('/coaching')}>{t('nav.coaching')}</a></li>
        <li><a href={l('/ueber-mich')}>{t('nav.about')}</a></li>
        <li><a href={l('/preise')}>{t('nav.prices')}</a></li>
        <li><a href={l('/fuer-unternehmen')}>{t('nav.companies')}</a></li>
        <li><a href={l('/kontakt')}>{t('nav.cta')}</a></li>
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label={t('footer.legal')}>
      <h2 class="site-footer__heading">{t('footer.legal')}</h2>
      <ul>
        <li><a href={l('/impressum')}>{t('footer.imprint')}</a></li>
        <li><a href={l('/datenschutz')}>{t('footer.privacy')}</a></li>
        <li>
          <button type="button" class="site-footer__consent" data-consent-open>
            {t('footer.cookies')}
          </button>
        </li>
        <li><a href={`${l('/kontakt')}#kontaktformular`}>{t('footer.contactForm')}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__credit-row">
    <a
      class="site-footer__credit"
      href="https://vemo-it-design.com/"
      target="_blank"
      rel="noopener"
    >
      <span>{t('footer.credit')}</span>
      <img
        src={vemoLogo.src}
        alt="VeMo IT &amp; Design"
        width="145"
        height="49"
        class="site-footer__credit-logo"
        loading="lazy"
      />
    </a>
  </div>

  <div class="site-footer__bar">
    <div class="container site-footer__bar-inner">
      <p class="site-footer__note">
        {t('footer.note')}
      </p>
      <p class="site-footer__copy">
        © {year} {t('footer.copy')}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest-deep);
    color: var(--on-dark);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }
  @media (min-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
  .site-footer__logo {
    width: 110px;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: var(--space-md);
  }
  .site-footer__tagline {
    color: var(--sage-harmony);
    max-width: 32ch;
    margin: 0;
  }
  .site-footer__heading {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sage-harmony);
    margin: 0 0 var(--space-md);
  }
  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .site-footer__nav a {
    color: var(--on-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .site-footer__nav a:hover {
    border-bottom-color: var(--sage-harmony);
  }
  /* „Cookie-Einstellungen“ ist ein Button (öffnet das Banner), sieht aber
     aus wie die Links daneben. */
  .site-footer__consent {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0;
    font: inherit;
    color: var(--on-dark);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .site-footer__consent:hover {
    border-bottom-color: var(--sage-harmony);
  }

  .site-footer__bar {
    border-top: 1px solid rgba(172, 191, 175, 0.25);
  }
  .site-footer__bar-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-lg);
  }
  .site-footer__note,
  .site-footer__copy {
    margin: 0;
    font-size: 0.85rem;
    color: var(--sage-harmony);
  }

  /* Kooperations-Hinweis: dezent, aber erkennbar. Das Logo ist dunkelblau
     und braucht deshalb auf dem dunkelgrünen Footer eine helle Fläche
     (#dce5f3). Sitzt über der Copyright-Linie, auf Container-Breite.
     Link zu VeMo (normaler Link, keine Verbindung vor dem Klick). */
  .site-footer__credit-row {
    display: flex;
    justify-content: flex-end;
    padding-bottom: var(--space-md);
  }
  .site-footer__credit {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.35em 0.75em;
    border-radius: 0;
    background: #dce5f3;
    color: #0c005e;
    font-size: 0.8rem;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .site-footer__credit:hover,
  .site-footer__credit:focus-visible {
    opacity: 1;
  }
  .site-footer__credit:focus-visible {
    outline: 2px solid var(--sage-harmony);
    outline-offset: 3px;
  }
  .site-footer__credit-logo {
    width: auto;
    height: 26px;
    flex-shrink: 0;
  }
</style>

<script>
  import { openConsentSettings } from '../lib/consent';

  // Gilt für alle „Cookie-Einstellungen“-Schalter der Seite (Footer und
  // Datenschutzerklärung).
  document.querySelectorAll('[data-consent-open]').forEach((btn) => {
    btn.addEventListener('click', () => openConsentSettings());
  });
</script>
