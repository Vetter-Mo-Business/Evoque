---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowerCorner from '../components/FlowerCorner.astro';
import portraitImg from '../assets/about/DSC00751.jpg';
import anchorImg from '../assets/about/DSC00842.jpg';
import logoImg from '../assets/about/Head_Logo_Evoque.svg';
import { type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'de') as Lang;

const content = {
  de: {
    metaTitle: 'Über mich',
    eyebrow: 'Über mich',
    title: 'Wer Dich begleitet.',
    lead: 'Ich bin Malin Langer, Wirtschaftspsychologin (B.Sc.) und als Coach selbstständig tätig. Aktuell vertiefe ich mein Wissen im Masterstudium Human Decision Science (M.Sc.) mit dem Schwerpunkt auf menschliches Verhalten und Entscheidungsprozesse.',
    bio: 'In meiner Arbeit als Coach verbinde ich fundiertes psychologisches Wissen aus meinem Studium mit evidenzbasierten Methoden und meiner praktischen Coaching-Erfahrung. Auf dieser Grundlage begleite ich Dich in Deiner persönlichen und beruflichen Entwicklung. Mich begeistert es, Menschen auf ihrem Weg zu unterstützen, ihre Ziele zu erreichen, Herausforderungen zu bewältigen und ihr Potenzial zu entfalten. Dabei ist mir besonders wichtig, einen strukturierten und gleichzeitig wertfreien Rahmen zu schaffen: Du bringst die Themen mit, die Dich bewegen, und ich übernehme die methodische Führung. Ich lege besonderen Wert darauf, Dir einen Raum zu bieten, in dem Du Dich reflektieren, neue Perspektiven entwickeln und Deinen eigenen Weg klarer sehen kannst.',
    valuesTitle: 'Was mir im Coaching wichtig ist',
    valuesText: 'Ich arbeite nach ethischen Richtlinien und mit einem hohen Anspruch an Vertraulichkeit und Datenschutz. Mein Ziel ist es, Dich dabei zu unterstützen, Deine Ziele möglichst effizient und zugleich nachhaltig zu erreichen. Deswegen werde ich Dich während und nach dem Coachingprozess stets ermutigen, Dich selbst mit den erlernten Techniken vertraut zu machen und diese zu üben. Mein Ziel ist es nicht, Dich möglichst lange an mich zu binden, sondern Dich so zu begleiten, dass Du Deine Herausforderungen eigenständig bewältigen und Deine Ziele langfristig erreichen kannst. Um die Qualität meiner Arbeit kontinuierlich zu sichern und eigene blinde Flecken sichtbar zu machen, nutze ich regelmäßig Supervisionen.',
    anchorEyebrow: 'Veränderung beginnt hier',
    anchorTitle: 'Ich bin Dein Anker und Deine Begleiterin.',
    anchorText:
      'Du gehst den Weg nicht allein. Ich bleibe an Deiner Seite, konzentriere mich auf Dich und stelle sicher, dass Du Dein Ziel erreichst.',
    portraitAlt: 'Porträt von Malin, Coach bei EVOQUE',
    anchorAlt: 'Malin – Porträt im Querformat',
    logoAlt: 'EVOQUE Logo',
  },
  en: {
    metaTitle: 'About',
    eyebrow: 'About',
    title: 'Who guides you.',
    lead: 'I am Malin Langer, business psychologist (B.Sc.) and self-employed as a coach. I am currently deepening my knowledge in the master’s programme Human Decision Science (M.Sc.), focusing on human behaviour and decision-making processes.',
    bio: 'In my work as a coach I combine sound psychological knowledge from my studies with evidence-based methods and my practical coaching experience. On this foundation I support you in your personal and professional development. I love helping people on their way to reach their goals, overcome challenges and unfold their potential. It is especially important to me to create a structured yet non-judgemental space: you bring the topics that move you, and I take the lead on the method. I place great value on offering you a space in which you can reflect, develop new perspectives and see your own path more clearly.',
    valuesTitle: 'What matters to me in coaching',
    valuesText: 'I work according to ethical guidelines and with a high standard of confidentiality and data protection. My goal is to support you in reaching your goals as efficiently and, at the same time, as sustainably as possible. That is why, during and after the coaching process, I will always encourage you to familiarise yourself with the techniques you have learned and to practise them. My aim is not to keep you dependent on me for as long as possible, but to guide you in a way that lets you master your challenges independently and reach your goals in the long term. To continuously ensure the quality of my work and to reveal my own blind spots, I regularly use supervision.',
    anchorEyebrow: 'Change starts here',
    anchorTitle: 'I am your anchor and guide.',
    anchorText:
      'You don’t walk the path alone. I stay by your side, focus on you and make sure you keep going – until you reach your goal!',
    portraitAlt: 'Portrait of Malin, coach at EVOQUE',
    anchorAlt: 'Malin – landscape portrait',
    logoAlt: 'EVOQUE logo',
  },
}[lang];
---

<BaseLayout title={content.metaTitle} description="">
  <!-- Vorstellung -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">{content.eyebrow}</p>
      <div class="intro">
        <div class="intro__media">
          <span class="intro-flower intro-flower--tl" aria-hidden="true">
            <FlowerCorner />
          </span>
          <Image
            src={portraitImg}
            alt={content.portraitAlt}
            widths={[640, 960, 1200, 1600]}
            sizes="(min-width: 860px) 40vw, 90vw"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
          <span class="intro-flower intro-flower--br" aria-hidden="true">
            <FlowerCorner />
          </span>
        </div>
        <div class="intro__text">
          <h1>{content.title}</h1>
          <p class="lead">{content.lead}</p>
          <p class="text-muted">{content.bio}</p>
        </div>
      </div>

      <!-- Was mir im Coaching wichtig ist – gespiegelt: Text links, Logo rechts -->
      <div class="values">
        <div class="values__text">
          <h2 class="values-title">{content.valuesTitle}</h2>
          <p class="text-muted">{content.valuesText}</p>
        </div>
        <div class="values__media">
          <img src={logoImg.src} alt={content.logoAlt} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Der Ansatz -->
  <section class="section surface-sand">
    <div class="container">
      <p class="eyebrow">{content.anchorEyebrow}</p>
      <div class="anchor">
        <div class="anchor__images">
          <Image
            src={anchorImg}
            alt={content.anchorAlt}
            widths={[768, 1200, 1600, 2048]}
            sizes="(min-width: 860px) 50vw, 90vw"
            quality={85}
            loading="lazy"
          />
        </div>
        <div class="anchor__text">
          <h2>{content.anchorTitle}</h2>
          <p>{content.anchorText}</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    /* etwas Luft, damit die obere Eckblume nicht an den "Über mich"-Text stößt */
    margin-top: var(--space-lg);
  }
  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  /* Werte-Block: gespiegelt zur Intro (Text links, Logo rechts) */
  .values {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    margin-top: var(--space-2xl);
  }
  @media (min-width: 860px) {
    .values {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .values-title {
    margin-top: 0;
    margin-bottom: var(--space-xs);
    font-size: 1.2rem;
  }
  .values__text p {
    margin-bottom: 0;
  }
  .values__media img {
    display: block;
    width: 100%;
    /* Head_Logo_Evoque ist quadratisch (viewBox 5906x5906) – zentriert und
       begrenzt. Mobil kompakt (nicht formatfüllend), auf großen Screens etwas
       größer. Fließend über clamp: skaliert mit der Viewport-Breite. */
    max-width: clamp(160px, 40vw, 320px);
    height: auto;
    margin-inline: auto;
  }
  .intro__media {
    position: relative;
    /* Mobil: Porträt nicht die ganze Breite einnehmen -> zentriert, begrenzt,
       damit es nicht "schwebend" wirkt. */
    max-width: clamp(240px, 72vw, 360px);
    margin-inline: auto;
  }
  .intro__media img {
    display: block;
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 860px) {
    /* Desktop: Breite steuert das Grid, Deckel wieder aufheben. */
    .intro__media,
    .values__media img {
      max-width: none;
      margin-inline: 0;
    }
    .values__media img {
      margin-inline: auto;
    }
  }

  /* Floraler Eckschmuck als Blumenrahmen */
  .intro-flower {
    position: absolute;
    width: clamp(84px, 32%, 150px);
    z-index: 2;
    pointer-events: none;
  }
  .intro-flower--tl {
    top: -20px;
    left: -20px;
  }
  .intro-flower--br {
    right: -20px;
    bottom: -20px;
    transform: rotate(180deg);
  }

  .anchor {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 860px) {
    .anchor {
      grid-template-columns: 1fr 1fr;
    }
  }
  .anchor__images {
    /* ===== HIER EINSTELLEN ===== */
    --img-zoom: 1.2; /* REINZOOMEN: Motiv größer -> schneidet oben UND unten weg (weniger Leerraum).
                        1 = aus, 1.3 = leicht rein, 1.6 = deutlich rein. Für "oben mehr weg": erhöhen. */
    --img-x: 50%; /* Links/Rechts: 0% = ganz links, 50% = Mitte, 100% = ganz rechts */
    --img-y: 35%; /* Nur VERSCHIEBEN (nicht zusätzlich schneiden): KLEINER = Ausschnitt rutscht hoch
                     (mehr unten weg), GRÖSSER = mehr oben weg. 0% = oben bündig, 100% = unten bündig. */
    --img-ratio: 3.7 / 3; /* Rahmen-Seitenverhältnis (Breite/Höhe). NICHT ändern, wenn das Layout
                             gleich bleiben soll. Zum Zuschneiden nur --img-zoom und --img-y verstellen. */
    /* =========================== */

    aspect-ratio: var(--img-ratio);
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    /* Mobil: nicht formatfüllend, sondern zentriert und begrenzt. */
    max-width: clamp(260px, 82vw, 420px);
    margin-inline: auto;
  }
  @media (min-width: 860px) {
    /* Desktop: Breite kommt aus dem 2-Spalten-Grid. */
    .anchor__images {
      max-width: none;
      margin-inline: 0;
    }
  }
  .anchor__images img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-x) var(--img-y);
    /* Zoom von der Mitte aus -> schneidet oben und unten gleichmäßig weg.
       Die vertikale Feinlage steuert --img-y (object-position) unabhängig davon. */
    transform: scale(var(--img-zoom));
    transform-origin: var(--img-x) center;
  }
  .anchor__text p {
    margin-bottom: 0;
  }
</style>
