---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TopicCard from '../components/TopicCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'de') as Lang;
const t = useTranslations(lang);
const l = (p: string) => localizePath(p, lang);
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')}>
  <Hero
    ctaHref={l('/kontakt') + '#buchung'}
    ctaLabel={t('home.hero.cta')}
    secondaryHref={l('/coaching')}
    secondaryLabel={t('home.hero.secondary')}
  />

  <!-- Ansatz-Teaser -->
  <section class="section surface-sand">
    <div class="container">
      <div class="approach">
        <div class="approach__intro">
          <SectionHeading
            eyebrow={t('home.approach.eyebrow')}
            title={t('home.approach.title')}
          >
            <p>{t('home.approach.text')}</p>
          </SectionHeading>
          <a href={`${l('/coaching')}#ansatz`} class="btn btn--primary">{t('home.approach.more')}</a>
        </div>
        <ol class="approach__steps">
          <li>
            <span class="approach__step-num"><span>1</span></span>
            <div>
              <h3>{t('home.approach.s1.title')}</h3>
              <p class="text-muted">{t('home.approach.s1.text')}</p>
            </div>
          </li>
          <li>
            <span class="approach__step-num"><span>2</span></span>
            <div>
              <h3>{t('home.approach.s2.title')}</h3>
              <p class="text-muted">{t('home.approach.s2.text')}</p>
            </div>
          </li>
          <li>
            <span class="approach__step-num"><span>3</span></span>
            <div>
              <h3>{t('home.approach.s3.title')}</h3>
              <p class="text-muted">{t('home.approach.s3.text')}</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Themen-Teaser -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow={t('home.topics.eyebrow')}
        title={t('home.topics.title')}
        align="center"
      >
        <p>{t('home.topics.lead')}</p>
      </SectionHeading>

      <div class="grid grid--3">
        <TopicCard title={t('home.topics.c2.title')}>
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="13" r="8" />
            <path d="M12 9v4l2.5 2" />
            <path d="M9 2h6" />
            <path d="M18.5 5.5l1.5 1.5" />
          </svg>
          {t('home.topics.c2.text')}
        </TopicCard>
        <TopicCard title={t('home.topics.c4.title')}>
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21v-8" />
            <path d="M12 13c0-3.6 2.4-6 6.5-6 0 3.6-2.4 6-6.5 6z" />
            <path d="M12 15c0-3-2-5-5.5-5 0 3 2 5 5.5 5z" />
          </svg>
          {t('home.topics.c4.text')}
        </TopicCard>
        <TopicCard title={t('home.topics.c5.title')}>
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18" />
            <path d="M12 5h6l2 2.5L18 10h-6" />
            <path d="M12 12H6l-2 2.5L6 17h6" />
          </svg>
          {t('home.topics.c5.text')}
        </TopicCard>
      </div>

      <p class="center themes-teaser__more">
        <a href={`${l('/coaching')}#themen`} class="btn btn--primary">{t('home.topics.more')}</a>
      </p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section surface-sand">
    <div class="container testimonials">
      <span class="testimonials__verified-badge" title={t('home.testi.badgeTitle')}>
        <svg
          class="testimonials__verified-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        {t('home.testi.badge')}
      </span>
      <SectionHeading
        eyebrow={t('home.testi.eyebrow')}
        title={t('home.testi.title')}
        align="center"
      >
        <p class="testimonials__note">{t('home.testi.note')}</p>
      </SectionHeading>
      <div class="grid grid--3">
        <Testimonial
          quote={t('home.testi.placeholder')}
          author={t('home.testi.t1.author')}
          topic={t('home.testi.t1.topic')}
          period={t('home.testi.t1.period')}
        />
        <Testimonial
          quote={t('home.testi.placeholder')}
          author={t('home.testi.t2.author')}
          topic={t('home.testi.t2.topic')}
          period={t('home.testi.t2.period')}
        />
        <Testimonial
          quote={t('home.testi.placeholder')}
          author={t('home.testi.t3.author')}
          topic={t('home.testi.t3.topic')}
          period={t('home.testi.t3.period')}
        />
      </div>
    </div>
  </section>

  <!-- Abschluss-CTA -->
  <section class="section">
    <div class="container">
      <div class="final-cta surface-forest">
        <div class="final-cta__text">
          <p class="eyebrow">{t('home.cta.eyebrow')}</p>
          <h2>{t('home.cta.title')}</h2>
          <p>{t('home.cta.text')}</p>
        </div>
        <div class="final-cta__actions">
          <a href={l('/kontakt') + '#buchung'} class="btn btn--secondary">{t('home.cta.button')}</a>
          <p class="final-cta__faq">
            <strong>{t('home.cta.faqPrompt')}</strong> {t('home.cta.faqText')}
            <a href={l('/preise') + '#faq'} class="final-cta__faq-link">{t('home.cta.faqLink')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Testimonials: Verifizierung + Anonymisierung */
  .testimonials {
    position: relative;
  }
  .testimonials__verified-badge {
    position: absolute;
    top: 0;
    right: var(--space-md);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #1d7a4d;
    background: #e8f5ee;
    border: 1px solid #bfe3cd;
    border-radius: 999px;
    padding: 0.4em 0.85em 0.4em 0.65em;
    line-height: 1;
    box-shadow: var(--shadow-soft);
  }
  .testimonials__verified-icon {
    width: 1.05em;
    height: 1.05em;
  }
  /* Der Notiz-Text soll auf möglichst 2 gleich lange Zeilen umbrechen.
     Der zentrierte Standard-Heading ist auf 60ch begrenzt (zu schmal ->
     3 Zeilen mit einem einzelnen Wort unten). Für die Testimonials den
     Textblock breiter machen, damit die Notiz in 2 Zeilen passt. */
  .testimonials :global(.section-heading--center) {
    max-width: 80ch;
  }
  .testimonials__note {
    margin-top: var(--space-sm);
    font-size: 0.95rem;
    /* balance verteilt den Text gleichmäßig auf die Zeilen -> saubere
       2 Zeilen ohne einzelnes Wort in einer neuen Zeile. */
    text-wrap: balance;
  }
  .testimonials__note-check {
    color: #1d7a4d;
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .testimonials__verified-badge {
      position: static;
      margin: 0 auto var(--space-md);
      display: inline-flex;
    }
    .testimonials {
      text-align: center;
    }
  }

  .approach {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (min-width: 860px) {
    .approach {
      grid-template-columns: 1fr 1fr;
    }
  }
  .approach__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }
  .approach__steps li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-md);
    align-items: start;
  }
  .approach__steps h3 {
    margin-bottom: var(--space-2xs);
  }
  .approach__steps p {
    margin: 0;
  }
  .approach__step-num {
    /* ===================== HIER ANPASSEN =====================
       Feinjustierung der Zahl im Kreis:
       negativer Wert = nach oben, positiver = nach unten (z.B. -1px / 1px) */
    --step-num-y: -3px;
    /* ========================================================= */

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--sage-harmony);
    color: var(--forest-deep);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1;
  }
  .approach__step-num > span {
    transform: translateY(var(--step-num-y));
  }

  .themes-teaser__more {
    margin-top: var(--space-xl);
  }

  .final-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    align-items: center;
    justify-content: space-between;
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
  }
  .final-cta__text {
    max-width: 52ch;
  }
  .final-cta__text h2 {
    margin-bottom: var(--space-sm);
  }
  .final-cta__text p:last-child {
    margin-bottom: 0;
  }
  /* Button + FAQ-Hinweis rechts als kleine Spalte */
  .final-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 30ch;
  }
  .final-cta__faq {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sage-harmony);
  }
  .final-cta__faq strong {
    color: var(--on-dark);
    font-weight: 600;
  }
  .final-cta__faq-link {
    color: var(--on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .final-cta__faq-link:hover {
    color: var(--sage-harmony);
  }
</style>
