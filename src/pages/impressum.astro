---
// Impressum – Text von Malin Langer (Stand Oktober 2026), wortgleich
// übernommen. Rechtstexte liefert und verantwortet die Kundin; Änderungen
// am Wortlaut nur nach Rücksprache mit ihr.
//
// Wirtschafts-Identifikationsnummer (§ 139c AO): noch nicht vergeben.
// Sobald sie vorliegt, den auskommentierten Abschnitt unten einkommentieren
// und die Nummer eintragen.
import BaseLayout from '../layouts/BaseLayout.astro';
import Email from '../components/Email.astro';
import { localizePath, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'de') as Lang;
const l = (p: string) => localizePath(p, lang);
const formHref = `${l('/kontakt')}#kontaktformular`;
const formUrlText = `evoque-yourself.com${formHref}`;

const meta = {
  de: { title: 'Impressum', desc: 'Impressum von EVOQUE – Malin Langer, Oelde.', eyebrow: 'Rechtliches' },
  en: { title: 'Imprint', desc: 'Imprint (legal notice) of EVOQUE – Malin Langer, Oelde, Germany.', eyebrow: 'Legal' },
}[lang];
---

<BaseLayout title={meta.title} description={meta.desc}>
  <section class="section">
    <div class="container container--narrow legal">
      <p class="eyebrow">{meta.eyebrow}</p>
      {lang === 'en' && (
        <p class="legal__lang-note">
          The legal notice (Impressum) is only available in German.
        </p>
      )}

      <div lang="de">
        <h1>Impressum</h1>

        <h2>Angaben gemäß § 5 DDG</h2>
        <p>
          Malin Langer<br />
          Inhaberin von EVOQUE<br />
          Joseph-Cardijn-Straße 30<br />
          59302 Oelde<br />
          Deutschland
        </p>

        <h2>Kontakt</h2>
        <p>
          E-Mail: <Email /><br />
          Online-Kontakt: Für eine schnelle Kontaktaufnahme nutzen Sie bitte mein
          Kontaktformular: <a href={formHref}>{formUrlText}</a>
        </p>

        {/*
        <h2>Wirtschafts-Identifikationsnummer</h2>
        <p>Wirtschafts-Identifikationsnummer gemäß § 139c AO: DE…</p>
        */}

        <h2>Verbraucherstreitbeilegung</h2>
        <p>
          Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen.
        </p>

        <h2>Widerspruch gegen Werbung</h2>
        <p>
          Der Nutzung der in diesem Impressum veröffentlichten Kontaktdaten zur Übersendung von
          nicht ausdrücklich angeforderter Werbung und Informationsmaterialien wird hiermit
          widersprochen. Ich behalte mir ausdrücklich rechtliche Schritte vor, insbesondere bei
          unverlangt zugesandten Werbe-E-Mails.
        </p>

        <h2>Hinweis zum Leistungsangebot</h2>
        <p>
          Das Coaching-Angebot von EVOQUE dient der persönlichen Weiterentwicklung und
          Potenzialentfaltung. Es stellt ein psychologisches Coaching dar und ersetzt weder eine
          Psychotherapie noch eine ärztliche oder heilkundliche Behandlung und stellt keine
          Diagnose- oder Therapieleistung dar.
        </p>

        <h2>Datenschutz</h2>
        <p>
          Informationen zur Verarbeitung personenbezogener Daten finden Sie in meiner
          <a href={l('/datenschutz')}>Datenschutzerklärung</a>.
        </p>

        <h2>Social Media</h2>
        <p>Dieses Impressum gilt auch für meinen Instagram-Auftritt @evoqueyourself.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h2 {
    margin-top: var(--space-xl);
    font-size: 1.4rem;
  }
  .legal p + p {
    margin-top: var(--space-sm);
  }
  .legal a {
    color: var(--forest-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .legal__lang-note {
    padding: var(--space-sm) var(--space-md);
    background: var(--soft-sand);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
</style>
