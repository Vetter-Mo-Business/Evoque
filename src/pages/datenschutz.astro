---

<BaseLayout title={c.metaTitle} description={c.metaDesc}>
  <section class="section">
    <div class="container container--narrow legal">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>

      <p class="lead">{c.intro}</p>

      {c.sections.map((s) => (
        <>
          <h2>{s.title}</h2>
          {s.blocks.map((b) =>
            'list' in b ? (
              <ul>
                {b.list.map((item) => <li>{item}</li>)}
              </ul>
            ) : (
              <p>{b.p}</p>
            ),
          )}
        </>
      ))}

      <p class="legal__note text-muted">{c.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h2 {
    margin-top: var(--space-xl);
    font-size: 1.4rem;
  }
  .legal p + p {
    margin-top: var(--space-sm);
  }
  .legal ul {
    margin: var(--space-sm) 0 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-2xs);
  }
  .legal__note {
    margin-top: var(--space-2xl);
    font-size: 0.9rem;
  }
</style>
