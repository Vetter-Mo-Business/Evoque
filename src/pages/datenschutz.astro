---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = (Astro.currentLocale ?? 'de') as 'de' | 'en';

const EMAIL = 'evoqueyourself.coaching@gmail.com';

// Struktur: Einleitung + Abschnitte. Ein Abschnitt hat einen Titel und
// Blöcke (Absatz oder Aufzählung). So bleibt die lange Erklärung übersichtlich
// und in beiden Sprachen gepflegt. Persönliche Pflichtangaben (Name, Anschrift,
// Telefon) sind als [BITTE AUSFÜLLEN] markiert.
type Block = { p: string } | { list: string[] };
type Section = { title: string; blocks: Block[] };

const c = {
  de: {
    metaTitle: 'Datenschutz',
    metaDesc: 'Datenschutzerklärung von EVOQUE – Yourself // Coaching & Strategy.',
    eyebrow: 'Rechtliches',
    title: 'Datenschutzerklärung',
    intro:
