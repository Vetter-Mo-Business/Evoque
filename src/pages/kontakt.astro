---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import portraitImg from '../assets/about/portrait.jpg';
import { localizePath, type Lang } from '../i18n/ui';

// Cal.com-Buchungslink im Format "benutzername/event-typ" eintragen.
// Beispiel: 'malin-evoque/kennenlernen'. Leer lassen -> Platzhalter wird angezeigt.
// Einrichtungs-Anleitung steht in src/components/BookingEmbed.astro.
const CAL_LINK = 'malin-langer-g1yec0/30min';

const lang = (Astro.currentLocale ?? 'de') as Lang;
const l = (p: string) => localizePath(p, lang);
const content = {
  de: {
    metaTitle: 'Kontakt & Buchung',
    metaDesc: 'Buche Dein kostenloses Kennenlerngespräch oder nimm direkt Kontakt zu EVOQUE auf.',
    introEyebrow: 'Kontakt & Buchung',
    introTitle: 'Lass uns kennenlernen.',
    introLead:
      'Buche Dein kostenloses Kennenlerngespräch oder kontaktiere mich direkt per Mail. Ich freue mich, von Dir zu hören!',
    bookEyebrow: 'Online buchen',
    bookTitle: 'Termin direkt sichern',
    directTitle: 'Kontaktiere mich direkt',
    email: 'E-Mail',
    emailNote: '[PLATZHALTER: finale E-Mail-Adresse bestätigen]',
    phone: 'Telefon',
    phoneValue: '[PLATZHALTER: Telefonnummer]',
    portraitAlt: 'Malin – EVOQUE',
    cardAlt: 'Visitenkarte von EVOQUE – Vorderseite',
    igTitle: 'EVOQUE auf Instagram',
    faqPrompt: 'Noch offene Fragen vor dem Gespräch?',
    faqCta: 'Häufige Fragen ansehen',
  },
  en: {
    metaTitle: 'Contact & Booking',
    metaDesc: 'Book your free intro call or get in touch with EVOQUE directly.',
    introEyebrow: 'Contact & Booking',
    introTitle: 'Let’s get to know each other.',
    introLead:
      'Book your free intro call or contact me directly – I look forward to hearing from you!',
    bookEyebrow: 'Book online',
    bookTitle: 'Secure your appointment directly',
    directTitle: 'Contact me directly',
    email: 'Email',
    emailNote: '[PLACEHOLDER: confirm final email address]',
    phone: 'Phone',
    phoneValue: '[PLACEHOLDER: phone number]',
    portraitAlt: 'Malin – EVOQUE',
    cardAlt: 'EVOQUE business card – front',
    igTitle: 'EVOQUE on Instagram',
    faqPrompt: 'Still have questions before the call?',
    faqCta: 'View the FAQ',
  },
}[lang];
---

<BaseLayout title={content.metaTitle} description={content.metaDesc}>
  <!-- Intro -->
  <section class="section section--tight">
    <div class="container container--narrow center">
      <p class="eyebrow">{content.introEyebrow}</p>
      <h1>{content.introTitle}</h1>
      <p class="lead">{content.introLead}</p>
    </div>
  </section>

  <!-- Online-Buchungskalender -->
  <section class="section section--tight">
    <div class="container">
      <div class="booking-wrap">
        <SectionHeading eyebrow={content.bookEyebrow} title={content.bookTitle} />
        <BookingEmbed calLink={CAL_LINK} />
      </div>
    </div>
  </section>

  <!-- Kontaktiere mich direkt -->
  <section class="section section--tight">
    <div class="container">
      <h2 class="contact-direct__title">{content.directTitle}</h2>

      <div class="contact-box">
        <div class="contact-direct">
        <article class="card contact-person">
          <div class="contact-person__avatar">
            <Image
              src={portraitImg}
              alt={content.portraitAlt}
              widths={[300, 480]}
              sizes="150px"
              quality={85}
              loading="lazy"
            />
          </div>
          <dl class="contact-list">
            <div>
              <dt>{content.email}</dt>
              <dd>
                <a href="mailto:evoqueyourself.coaching@gmail.com"
                  >evoqueyourself.coaching@gmail.com</a
                >
                <span class="contact-note">{content.emailNote}</span>
              </dd>
            </div>
            <div>
              <dt>{content.phone}</dt>
              <dd>{content.phoneValue}</dd>
            </div>
          </dl>
        </article>

        <div class="ig-embed">
          <iframe
            src="https://www.instagram.com/evoqueyourself/embed"
            title={content.igTitle}
            loading="lazy"
            scrolling="no"
            frameborder="0"
            allowtransparency="true"
          ></iframe>
        </div>
        </div>
      </div>

      <p class="contact-faq">
        <span class="contact-faq__prompt">{content.faqPrompt}</span>
        <a href={`${l('/preise')}#faq`} class="btn btn--primary">{content.faqCta}</a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .contact-direct__title {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* FAQ-Verweis unter dem Direktkontakt */
  .contact-faq {
    margin: var(--space-2xl) 0 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .contact-faq__prompt {
    color: var(--calm-earth);
    font-size: 0.95rem;
  }

  /* Große Box rund um den ganzen Direktkontakt-Bereich */
  .contact-box {
    background: var(--soft-sand);
    border: var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-2xl);
  }

  /* Zwei Spalten: links Personen-Karte, rechts Visitenkarte */
  .contact-direct {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 760px) {
    .contact-direct {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Linke Karte mit Foto-Kreis oben */
  .contact-person {
    text-align: center;
    display: grid;
    gap: var(--space-lg);
    justify-items: center;
  }
  .contact-person__avatar {
    width: 140px;
    height: 140px;
    border-radius: 999px;
    overflow: hidden;
    border: 3px solid var(--sage-harmony);
    box-shadow: var(--shadow-soft);
  }
  .contact-person__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .contact-list {
    margin: 0;
    display: grid;
    gap: var(--space-lg);
    justify-items: center;
    text-align: center;
  }
  .contact-list dt {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--calm-earth);
    margin-bottom: var(--space-2xs);
  }
  .contact-list dd {
    margin: 0;
    font-size: 1.1rem;
  }
  .contact-list a {
    color: var(--forest-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-note {
    display: block;
    font-size: 0.82rem;
    color: var(--calm-earth);
  }

  /* Instagram-Feed-Einbettung (rechte Spalte, statt Visitenkarte).
     Breite begrenzt -> Inhaltshöhe bleibt vorhersehbar; zusammen mit
     scrolling="no" am Iframe verhindert das den internen Scrollbalken. */
  .ig-embed {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    border: var(--border-soft);
    background: #fff;
  }
  .ig-embed iframe {
    display: block;
    width: 100%;
    border: 0;
    /* Höhe passend zum Instagram-Profil-Embed (kein interner Scroll).
       Bei Bedarf hier fein justieren. */
    height: 540px;
  }
</style>
