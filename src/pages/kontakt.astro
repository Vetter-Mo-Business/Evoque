---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import portraitImg from '../assets/about/DSC00751.jpg';
import qrImg from '../assets/about/QR_Malin.jpeg';
import { localizePath, type Lang } from '../i18n/ui';

// Cal.com-Buchungslink im Format "benutzername/event-typ" eintragen.
// Beispiel: 'malin-evoque/kennenlernen'. Leer lassen -> Platzhalter wird angezeigt.
// Einrichtungs-Anleitung steht in src/components/BookingEmbed.astro.
const CAL_LINK = 'tim-vetter-6ryc7s/kennenlerngesprach';

const lang = (Astro.currentLocale ?? 'de') as Lang;
const l = (p: string) => localizePath(p, lang);
const content = {
  de: {
    metaTitle: 'Kontakt & Buchung',
    metaDesc: 'Buche Dein kostenloses Kennenlerngespräch oder nimm direkt Kontakt zu EVOQUE auf.',
    introEyebrow: 'Kontakt & Buchung',
    introTitle: 'Lerne mich kennen. / Lass uns kennenlernen.',
    introLead:
      'Buche dein kostenloses Kennenlerngespräch oder kontaktiere mich per Mail. Ich freue mich, von dir zu hören!',
    bookEyebrow: 'Online buchen',
    bookTitle: 'Termin direkt sichern',
    directTitle: 'Kontaktiere mich gerne direkt',
    email: 'E-Mail',
    emailNote: '[PLATZHALTER: finale E-Mail-Adresse bestätigen]',
    instagram: 'Instagram',
    instagramHandle: '@evoqueyourself',
    portraitAlt: 'Malin – EVOQUE',
    cardAlt: 'QR-Code zum EVOQUE Instagram-Profil',
    faqPrompt: 'Noch offene Fragen vor dem Gespräch?',
    faqCta: 'Häufige Fragen ansehen',
  },
  en: {
    metaTitle: 'Contact & Booking',
    metaDesc: 'Book your free intro call or get in touch with EVOQUE directly.',
    introEyebrow: 'Contact & Booking',
    introTitle: 'Let’s get to know each other.',
    introLead:
      'Book your free intro call or contact me directly – I look forward to hearing from you!',
    bookEyebrow: 'Book online',
    bookTitle: 'Secure your appointment directly',
    directTitle: 'Contact me directly',
    email: 'Email',
    emailNote: '[PLACEHOLDER: confirm final email address]',
    instagram: 'Instagram',
    instagramHandle: '@evoqueyourself',
    portraitAlt: 'Malin – EVOQUE',
    cardAlt: 'QR code to the EVOQUE Instagram profile',
    faqPrompt: 'Still have questions before the call?',
    faqCta: 'View the FAQ',
  },
}[lang];
const instagramUrl = 'https://www.instagram.com/evoqueyourself';
---

<BaseLayout title={content.metaTitle} description={content.metaDesc}>
  <!-- Intro -->
  <section class="section section--tight">
    <div class="container container--narrow center">
      <p class="eyebrow">{content.introEyebrow}</p>
      <h1>{content.introTitle}</h1>
      <p class="lead">{content.introLead}</p>
    </div>
  </section>

  <!-- Online-Buchungskalender -->
  <section class="section section--tight">
    <div class="container">
      <div class="booking-wrap">
        <SectionHeading eyebrow={content.bookEyebrow} title={content.bookTitle} />
        <BookingEmbed calLink={CAL_LINK} />
      </div>
    </div>
  </section>

  <!-- Kontaktiere mich direkt -->
  <section class="section section--tight">
    <div class="container">
      <h2 class="contact-direct__title">{content.directTitle}</h2>

      <div class="contact-box">
        <div class="contact-direct">
        <article class="card contact-person">
          <div class="contact-person__avatar">
            <Image
              src={portraitImg}
              alt={content.portraitAlt}
              widths={[300, 480]}
              sizes="150px"
              quality={85}
              loading="lazy"
            />
          </div>
          <dl class="contact-list">
            <div>
              <dt>{content.email}</dt>
              <dd>
                <a href="mailto:evoqueyourself.coaching@gmail.com"
                  >evoqueyourself.coaching@gmail.com</a
                >
                <span class="contact-note">{content.emailNote}</span>
              </dd>
            </div>
            <div>
              <dt>{content.instagram}</dt>
              <dd>
                <a href={instagramUrl} target="_blank" rel="noopener"
                  >{content.instagramHandle}</a
                >
              </dd>
            </div>
          </dl>
        </article>

        <div class="contact-card-visual">
          <Image
            src={qrImg}
            alt={content.cardAlt}
            widths={[300, 480, 600]}
            sizes="(max-width: 760px) 80vw, 400px"
            quality={85}
            loading="lazy"
          />
        </div>
        </div>

        <p class="contact-faq">
          <span class="contact-faq__prompt">{content.faqPrompt}</span>
          <a href={`${l('/preise')}#faq`} class="btn btn--primary">{content.faqCta}</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .contact-direct__title {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  /* FAQ-Verweis unter beiden Karten (in der Box), Text links, Button rechts –
     auf schmalen Bildschirmen bricht er um. (identisch zur Unternehmensseite) */
  .contact-faq {
    margin: var(--space-lg) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    text-align: center;
  }
  .contact-faq__prompt {
    color: var(--forest-deep);
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Große Box rund um den ganzen Direktkontakt-Bereich */
  .contact-box {
    max-width: 720px;
    margin-inline: auto;
    background: var(--soft-sand);
    border: var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-lg);
  }

  /* Zwei Spalten: links Personen-Karte, rechts QR-Code */
  .contact-direct {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 760px) {
    .contact-direct {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  /* Linke Karte mit Foto-Kreis oben */
  .contact-person {
    text-align: center;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }
  .contact-person__avatar {
    width: 140px;
    height: 140px;
    border-radius: 999px;
    overflow: hidden;
    border: 3px solid var(--sage-harmony);
    box-shadow: var(--shadow-soft);
  }
  .contact-person__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .contact-list {
    margin: 0;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
  }
  .contact-list dt {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--calm-earth);
    margin-bottom: var(--space-2xs);
  }
  .contact-list dd {
    margin: 0;
    font-size: 1.1rem;
  }
  .contact-list a {
    color: var(--forest-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-note {
    display: block;
    font-size: 0.82rem;
    color: var(--calm-earth);
  }

  /* QR-Seite als eigene weiße Karte – gleiche Optik wie die Personen-Karte,
     damit beide Spalten gleich hoch wirken. Der QR bleibt quadratisch
     (nicht gequetscht) und sitzt mittig. Gleiche Höhe kommt aus dem
     align-items: stretch des Rasters. */
  .contact-card-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    border: var(--border-soft);
    padding: var(--space-lg);
  }
  .contact-card-visual img {
    width: 100%;
    max-width: 260px;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
</style>
