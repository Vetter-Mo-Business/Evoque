    introLead:
      'Not single sessions for sale, but real guidance – for as long as your topic needs.',
    basicsEyebrow: 'Getting started',
    basicsTitle: 'Understanding coaching',
    whatEyebrow: 'In brief',
    whatTitle: 'What is coaching?',
    whatText:
      'Serious psychological coaching is aimed exclusively at healthy people, to support them with private or professional challenges. Within the coaching process, problematic behaviours that trouble the coachee and limit them on the way to their goals or in everyday life are worked through systematically. In coaching at EVOQUE, we look together at the root of the problem and create a lasting, healthy change in behaviour with the help of psychologically grounded and scientific methods.',
    topicsEyebrow: 'Topics & concerns',
    topicsTitle: 'What people come to me with',
    topicsLead: 'Common concerns – and room for your personal topic.',
    carouselLabel: 'Topics people come with',
    prev: 'Previous topic',
    next: 'Next topic',
    topics: [
      {
        title: 'Concentration difficulties',
        items: [
          { term: 'Procrastination', desc: 'Get into action instead of putting tasks off again and again.' },
          { term: 'Focus', desc: 'Bundle your attention and stay concentrated on one thing for longer.' },
          { term: 'Distractions', desc: 'Recognise sources of distraction and create focused phases on purpose.' },
          { term: 'Multitasking', desc: 'Focus on one thing at a time, working with clarity and effect.' },
        ],
      },
      {
        title: 'Weight concerns',
        items: [
          { term: 'Losing weight', desc: 'Understand the causes behind eating habits and lose weight sustainably.' },
          { term: 'Gaining weight', desc: 'Put on weight in a healthy way and develop a good sense of your body.' },
