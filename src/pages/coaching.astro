---

<BaseLayout title={content.metaTitle} description={content.metaDesc}>
  <!-- Intro -->
  <section class="section section--tight">
    <div class="container container--narrow center">
      <p class="eyebrow">{content.introEyebrow}</p>
      <h1>{content.introTitle}</h1>
      <p class="lead">{content.introLead}</p>
    </div>
  </section>

  <!-- Grundlagen: "Was ist Coaching?" & "Mehr über den Ansatz" untereinander -->
  <section class="section section--tight basics-section" id="ansatz">
    <div class="container container--narrow">
      <SectionHeading
        eyebrow={content.basicsEyebrow}
        title={content.basicsTitle}
        align="center"
      />
      <div class="expectations basics-details">
        <details class="expectation">
          <summary class="expectation__summary">{content.whatTitle}</summary>
          <div class="expectation__body">
            <p>{content.whatText}</p>
          </div>
        </details>
        <details class="expectation" id="ansatz-details">
          <summary class="expectation__summary">{content.approachTitle}</summary>
          <div class="expectation__body">
            <p>{content.approachText}</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Themen / Anliegen -->
  <section class="section topics-section" id="themen">
    <div class="container">
      <SectionHeading
        eyebrow={content.topicsEyebrow}
        title={content.topicsTitle}
      >
        <p>{content.topicsLead}</p>
      </SectionHeading>

      <div
        class="topic-slider"
        data-topic-slider
        role="group"
        aria-roledescription={lang === 'en' ? 'Carousel' : 'Karussell'}
        aria-label={content.carouselLabel}
      >
        <div class="topic-slider__viewport" data-viewport>
          <div class="topic-slider__track" data-track>
            {
              content.topics.map((topic, i) => (
                <div class="topic-slider__slide">
                  <TopicCard
                    title={topic.title}
                    items={topic.items}
                    image={topicImages[i]}
                  />
                </div>
              ))
            }
            <div class="topic-slider__slide">
              <TopicCard
                title={content.placeholderTitle}
                image={imgThema}
                placeholder
              >
                {content.placeholderText}
              </TopicCard>
            </div>
          </div>
        </div>

        <div class="topic-slider__controls">
          <button
            type="button"
            class="topic-slider__nav"
            data-prev
            aria-label={content.prev}
          >
            ‹
          </button>
          <div class="topic-slider__dots" data-dots aria-hidden="true"></div>
          <button
            type="button"
            class="topic-slider__nav"
            data-next
            aria-label={content.next}
          >
            ›
          </button>
        </div>
      </div>

      <p class="topics-disclaimer">
        <span class="topics-disclaimer__label">Disclaimer</span>
        {content.disclaimerText}
      </p>
    </div>
  </section>

  <!-- Ablauf-Prozess: gepinnte Scroll-Animation -->
  <ProcessJourney />

  <!-- Persönliche Note: "Was mir wichtig ist" – direkt unter dem Ablauf -->
  <section class="section important-section">
    <div class="container">
      <div class="important">
        <div class="important__note">
          <h3 class="important__title">{content.importantTitle}</h3>
          <p>{content.importantText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- USP: Der Unterschied zur üblichen Herangehensweise -->
  <section class="section surface-sand">
    <div class="container">
      <SectionHeading
        eyebrow={content.uspEyebrow}
        title={content.uspTitle}
        align="center"
      >
        <p>{content.uspLead}</p>
      </SectionHeading>
      <div class="grid grid--3 offer-grid">
        <article class="card offer-card offer-card--others">
          <span class="offer-card__tag offer-card__tag--muted">{content.groupTag}</span>
          <h3>{content.groupTitle}</h3>
          <p class="text-muted">{content.groupText}</p>
          <ul class="offer-list offer-list--cons">
            {content.groupCons.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="card offer-card offer-card--highlight">
          <span class="offer-card__tag">{content.evoqueTag}</span>
          <h3>{content.evoqueTitle}</h3>
          <p>{content.evoqueText}</p>
          <ul class="offer-list">
            {content.evoquePros.map((item) => <li>{item}</li>)}
          </ul>
          <div class="offer-highlight">
            <a href={`${l('/kontakt')}#buchung`} class="btn btn--primary offer-highlight__cta">
              {content.evoqueHighlightCta}
            </a>
          </div>
        </article>
        <article class="card offer-card offer-card--others">
          <span class="offer-card__tag offer-card__tag--muted">{content.soloTag}</span>
          <h3>{content.soloTitle}</h3>
          <p class="text-muted">{content.soloText}</p>
          <ul class="offer-list offer-list--cons">
            {content.soloCons.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Abgrenzung zur Psychotherapie: Dropdown-Frage + Hinweis -->
  <section class="section" id="psychotherapie">
    <div class="container">
      <SectionHeading
        eyebrow={content.therapyEyebrow}
        title={content.therapyTitle}
        align="center"
      />
      <div class="therapy">
        <details class="expectation therapy__details" id="psychotherapie-details">
          <summary class="expectation__summary">{content.therapyQuestion}</summary>
          <div class="expectation__body">
            <p>{content.therapyAnswer}</p>
          </div>
        </details>
        <p class="therapy-note">
          <span class="therapy-note__label">{content.therapyNoteLabel}</span>
          {content.therapyNote}
        </p>
        <p class="faq-cta">
          <span class="faq-cta__prompt">{content.faqPrompt}</span>
          <a href={`${l('/preise')}#faq`} class="btn btn--primary">{content.faqCta}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

