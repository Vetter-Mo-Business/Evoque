          { term: 'No goals', desc: 'Find your own goals and set a path towards them.' },
        ],
      },
      {
        title: 'Stress',
        items: [
          { term: 'Time management', desc: 'Set priorities and shape your day more calmly and clearly.' },
          { term: 'Inner restlessness', desc: 'Calm the constant inner drive and find composure.' },
          { term: 'Sleep problems', desc: 'Come to rest and sleep more restfully again.' },
