    ],
    evoqueTag: 'Coaching bei EVOQUE',
    evoqueTitle: 'Begleitung mit Fundament',
    evoqueText:
      'Echte Begleitung, ganzheitlich auf Dich zugeschnitten. Psychologisch fundiert, wissenschaftliche Methoden. Ich bleibe an Deiner Seite, bis Du Dein Ziel erreicht hast.',
    evoquePros: [
