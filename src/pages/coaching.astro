        ],
      },
      {
        title: 'Entscheidungen',
        items: [
          { term: 'Hilflosigkeit', desc: 'Aus dem Gefühl der Ausweglosigkeit wieder in die Handlungsfähigkeit kommen.' },
          { term: 'Fehlende Klarheit', desc: 'Herausfinden, was du wirklich willst, und Klarheit gewinnen.' },
          { term: 'Keine Ziele', desc: 'Eigene Ziele finden und einen Weg dorthin festlegen.' },
        ],
      },
      {
        title: 'Stress',
        items: [
          { term: 'Zeitmanagement', desc: 'Prioritäten setzen und den Tag ruhiger und strukturierter gestalten.' },
