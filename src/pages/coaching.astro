---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TopicCard from '../components/TopicCard.astro';
import ProcessJourney from '../components/ProcessJourney.astro';
import { localizePath, type Lang } from '../i18n/ui';

// Skizzen für die Themen-Karten (transparente PNGs, dunkelgrüne Striche).
// Reihenfolge = Reihenfolge von content.topics. Für "Ängste" gibt es
// bewusst kein Bild (undefined) – die Karte bleibt dort ohne Skizze.
import imgKonzentration from '../assets/topics/konzentration.png';
import imgGewicht from '../assets/topics/gewicht.png';
import imgAengste from '../assets/topics/aengste.png';
import imgEntscheidungen from '../assets/topics/entscheidungen.png';
import imgStress from '../assets/topics/stress.png';
import imgBeruflich from '../assets/topics/beruflich.png';
import imgWeitere from '../assets/topics/weitere.png';
import imgThema from '../assets/topics/thema.png';

const topicImages = [
  imgKonzentration, // Konzentrationsschwierigkeiten
  imgGewicht,       // Gewichtsunsicherheiten
  imgAengste,       // Ängste
  imgEntscheidungen,// Entscheidungen
  imgStress,        // Stress
  imgBeruflich,     // Beruflich
  imgWeitere,       // Weitere Anliegen
];

const lang = (Astro.currentLocale ?? 'de') as Lang;
const l = (p: string) => localizePath(p, lang);

